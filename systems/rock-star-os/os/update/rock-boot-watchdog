#!/bin/sh
# Software boot watchdog; no hardware/kernel-lockup guarantee.
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
[ -f /run/rock-boot.json ] || exit 1
attempt=0
while [ "$attempt" -lt 120 ]; do
  [ ! -f /run/rock-boot-good.json ] || exit 0
  sleep 1
  attempt=$((attempt + 1))
done
echo ROCK_AB_WATCHDOG_REBOOT > /dev/console
sync
reboot -f
