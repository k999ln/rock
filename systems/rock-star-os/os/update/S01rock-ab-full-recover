#!/bin/sh
# Development-only: restore only the disposable full-data fixture's capacity.
set -eu
[ "${1:-start}" = start ] || exit 0
case " $(cat /proc/cmdline) " in
  *' rock.abtest=fault-full-recover '*) ;;
  *) exit 0 ;;
esac
/usr/bin/python3 -B -I /usr/lib/rock-update/early_recover.py || {
  echo ROCK_AB_EARLY_RECOVERY_FAIL
  exit 1
}
