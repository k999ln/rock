{
  "name": "noah-cloud-agents",
  "account_id": "ae3e6c52c0a9e50aab66a6e4184aa09e",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-22",
  "containers": [{ "class_name": "NoahCloudJob", "scheduling_policy": "durable_object", "images": { "base": { "dockerfile": "./container/Dockerfile" } } }],
  "durable_objects": { "bindings": [
    { "name": "JOBS", "class_name": "NoahCloudJob" },
    { "name": "CONNECTIONS", "class_name": "NoahCloudConnection" },
    { "name": "BUDGET", "class_name": "NoahCloudBudget" }
  ] },
  "exports": {
    "NoahCloudJob": { "type": "durable-object", "storage": "sqlite" },
    "NoahCloudConnection": { "type": "durable-object", "storage": "sqlite" },
    "NoahCloudBudget": { "type": "durable-object", "storage": "sqlite" }
  },
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 30000 }
}
