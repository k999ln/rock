# Public configuration (copy values into wrangler.jsonc).
SKY_ORIGIN=https://your-sky.example

# Secrets. Add with `wrangler secret put`; never commit real values.
BILLING_SHARED_SECRET=at-least-32-random-characters-shared-with-sky
SETTLEMENT_INGEST_SECRET=at-least-32-random-characters-shared-with-the-sky-earning-bridge
PAYOUT_ADAPTER_SECRET=at-least-32-random-characters-shared-with-the-payout-adapter
# Public address only. Never put a seed phrase or private key here.
BASE_RPC_URL=https://mainnet.base.org
