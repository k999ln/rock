# Secrets. Add with `wrangler secret put`; never commit real values.
BILLING_SHARED_SECRET=at-least-32-random-characters-shared-with-sky
SETTLEMENT_INGEST_SECRET=at-least-32-random-characters-shared-with-provider-adapters
