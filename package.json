{
  "name": "rock-star",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "lint:product": "oxlint app lib db components/*.tsx scripts/*.mjs tests/*.mjs",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:api": "node scripts/check-work-api.mjs",
    "typecheck": "tsc --noEmit",
    "project:update": "node scripts/project-status.mjs",
    "project:check": "node scripts/project-status.mjs --check",
    "db:generate": "node scripts/generate-migration.mjs",
    "verify": "npm run project:check && npm run typecheck && npm run lint:product && npm test && npm run build && npm run test:api",
    "discover": "node scripts/discover.mjs",
    "os:check": "node scripts/check-os-contracts.mjs",
    "os:host": "node scripts/check-os-host.mjs",
    "os:parity": "node --experimental-strip-types scripts/check-os-parity.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.0",
    "@cloudflare/workers-types": "5.20260811.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "^0.31.10",
    "miniflare": "5.20260811.0-alpha",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.122.0"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
