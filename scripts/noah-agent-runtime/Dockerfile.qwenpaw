FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df AS dependencies
COPY qwenpaw/build-requirements.lock qwenpaw/requirements.lock /opt/noah-lock/
RUN pip install --no-cache-dir --require-hashes -r /opt/noah-lock/build-requirements.lock && \
    pip install --no-cache-dir --no-build-isolation --require-hashes -r /opt/noah-lock/requirements.lock && \
    pip check && pip freeze > /opt/dependencies.txt
RUN useradd --uid 10001 --create-home agent
COPY runner.py qwenpaw_sdk.py /opt/noah/
ENV HOME=/home/agent PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DO_NOT_TRACK=1 HF_HUB_OFFLINE=1 QWENPAW_WORKING_DIR=/home/agent/.qwenpaw QWENPAW_SECRET_DIR=/home/agent/.qwenpaw-secret
USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["python", "/opt/noah/runner.py"]
