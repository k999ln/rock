---
import "../../style.css";
import "../../pro-experience.css";
import ProAssemblyWorkbench from "../../components/ProAssemblyWorkbench.astro";
import { proDesign } from "../../pro-design.js";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#050505" />
  <meta name="description" content="avokadoPro is a compact NVIDIA PC design for si and PC games. Mini is optional. Hardware and performance are unvalidated; sales are closed." />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="avokadoPro — Compact NVIDIA PC design" />
  <meta property="og:description" content="A standalone PC design for si and games. Optional Mini input. Not yet assembled." />
  <meta property="og:url" content="https://avocadomini.si/pro/" />
  <meta name="twitter:card" content="summary" />
  <link rel="canonical" href="https://avocadomini.si/pro/" />
  <title>avokadoPro — Compact NVIDIA PC design</title>
  <link rel="icon" href="/images/avokado-metallic-mark.png" type="image/png" />
  <script is:inline src="/site-enhancements.js" defer></script>
</head>
<body class="pro-product-page">
  <a class="skip" href="#pro-overview">Skip to product</a>
  <header class="site-header pro-header">
    <a class="brand avokado-brand" href="/"><img class="avokado-brand-icon" src="/images/avokado-metallic-mark.png" alt="" aria-hidden="true" />avokado</a>
    <nav class="primary-nav" aria-label="Primary navigation"><a href="#pro-use-cases">Use cases</a><a href="#pro-highlights">Highlights</a><a href="#pro-pairing">Pair with Mini</a><a href="#pro-price">Price</a></nav>
    <div class="header-actions"><details class="site-menu"><summary>Menu</summary><div class="site-menu-panel"><p>AVOKADOPRO</p><nav aria-label="Product navigation"><a href="#pro-use-cases"><span>01</span><strong>Use cases</strong><em>si · games · creation</em></a><a href="#pro-highlights"><span>02</span><strong>Benefits</strong><em>Candidate hardware · validation</em></a><a href="#pro-pairing"><span>03</span><strong>Pair with Mini</strong><em>Let the room join in</em></a><a href="#pro-price"><span>04</span><strong>Price</strong><em>¥800,000 design target</em></a><a href="/mini/"><span>05</span><strong>avocadoMini</strong><em>Add spatial input</em></a></nav></div></details><a class="header-cta" href="/preorder/">Price & status <span aria-hidden="true">↗</span></a></div>
  </header>

  <main>
    <section id="pro-build" aria-label="avocadoPro build concept"><ProAssemblyWorkbench />
<section id="pro-interest" class="pro-interest" aria-labelledby="pro-interest-title"><div><p class="pro-kicker">04 / FIRST-BUILD INTEREST · UNITED STATES FIRST</p><h2 id="pro-interest-title">Help shape the first Pro.</h2><p>Share your configuration and what you want to make. avokado LLC is preparing a one-at-a-time US build-to-order launch. We will contact you when the exact parts, a tested prototype, price, shipping window, and purchase terms are ready.</p><ol class="pro-interest-steps"><li><strong>01 · Configure</strong><span>Choose a concept build and tell us your use case.</span></li><li><strong>02 · Prove the hardware</strong><span>We validate the exact parts, fit, cooling, software, and supply on a real machine.</span></li><li><strong>03 · Review your offer</strong><span>See the final configuration, total price, shipping window, warranty, and return terms before deciding.</span></li><li><strong>04 · Build and ship</strong><span>After an accepted paid order, the machine is assembled, tested, packed, and tracked to delivery.</span></li></ol><p class="pro-interest-current">Selected: <strong data-interest-configuration>Studio / Value</strong></p><p class="pro-interest-honesty">The US is the first planned sales region. Joining the list is free. It is not an order or a reservation; no payment or delivery promise is being offered yet.</p></div><div class="pro-interest-panel"><form data-pro-interest-form><label>Email for a reply<input type="email" name="email" autocomplete="email" required maxlength="254" placeholder="you@example.com" /></label><label>Country or region <span>(optional)</span><input type="text" name="region" autocomplete="country-name" maxlength="80" placeholder="Where would you buy it?" /></label><label>What would you build with it? <span>(optional)</span><textarea name="note" rows="3" maxlength="500" placeholder="Tell us your AI workflow and why you need a dedicated PC."></textarea></label><input class="pro-honeypot" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" /><label class="pro-interest-consent"><input type="checkbox" name="contactConsent" required /><span>I agree to be contacted about this avocadoPro configuration. I understand this is not an order or payment. <a href="/privacy/">Privacy details</a>.</span></label><button type="submit" data-interest-submit disabled>Join the first-build list ↗</button><p data-interest-status role="status" aria-live="polite">Checking availability…</p></form><div data-interest-receipt class="pro-interest-receipt" hidden><h3>Request received.</h3><p>Keep this receipt to remove your request later. No payment was taken.</p><dl><div><dt>Request ID</dt><dd data-receipt-id></dd></div><div><dt>Removal code</dt><dd data-receipt-code></dd></div></dl><button type="button" data-remove-interest>Remove my request</button><p data-remove-status role="status" aria-live="polite"></p></div></div></section></section>
    <section id="pro-overview" class="pro-hero" aria-labelledby="pro-title">
      <figure class="pro-design-figure"><img src={proDesign.image} alt="Existing Pro design study: compact silver PC enclosure and candidate hardware, not an assembled product" fetchpriority="high" /><figcaption>2026-10-05 design study. Enclosure fit and cooling are unvalidated. <a href={proDesign.image}>Open full-size concept ↗</a></figcaption></figure>
      <div class="pro-hero-shade" aria-hidden="true"></div>
      <div class="pro-hero-copy">
        <p class="eyebrow">COMPACT NVIDIA PC / DESIGN P0</p>
        <h1 id="pro-title">avokadoPro</h1>
        <p class="pro-hero-line">si. PC games.<br />A place on your desk.</p>
        <p>A standalone desktop PC design for local si, games, and creation. Connect a display, keyboard, and mouse. Mini is optional spatial input.</p>
        <a href="#pro-highlights">Explore the design <span aria-hidden="true">↓</span></a>
      </div>
      <p class="film-disclaimer">Not yet assembled · No measured performance · Sales closed</p>
    </section>

    <section class="pro-statement" aria-labelledby="pro-statement-title"><p class="eyebrow">INDEPENDENT BY DESIGN</p><h2 id="pro-statement-title">A PC on its own.<br />Mini when you choose.</h2><p>Pro is designed to work without Mini. Mini’s separate R5 design also targets standalone operation without Pro. Pairing is an optional extension, not a requirement to start either product.</p></section>

    <section id="pro-use-cases" class="product-use-cases product-use-cases-pro" aria-labelledby="pro-use-cases-title">
      <div class="product-use-cases-head"><p class="eyebrow">WHAT WE AIM TO BUILD</p><h2 id="pro-use-cases-title">si and games.<br />On your desk.</h2><p>The current design combines NVIDIA GPU compute with PC gaming. These are intended uses, not tested product capabilities.</p></div>
      <div class="product-use-case-grid">
        <article><span>LOCAL si</span><strong>Try a model.<br />Measure what fits.</strong><p>Model inference and creation are candidate workloads. Supported models, speed, and GPU memory use still need testing.</p></article>
        <article><span>PC GAMES</span><strong>Choose a title.<br />Verify the experience.</strong><p>Game compatibility, frame rate, drivers, and recovery must be measured on the same hardware and OS. No universal game support is claimed.</p></article>
        <article><span>CREATE</span><strong>Keep the project<br />close to you.</strong><p>Local apps, assets, and storage are part of the design. Games and si may compete for memory and power.</p></article>
        <article><span>OPTIONAL SPATIAL INPUT</span><strong>Add Mini<br />when it helps.</strong><p>Mini pairing needs device identity, permissions, calibration, and stop/recovery validation. Four Minis are not a required PC configuration.</p></article>
      </div>
      <p class="product-use-cases-note">No Pro hardware has been assembled or accepted. Cloud work requires separate consent and a cost limit. Medical and safety-critical uses require separate validation.</p>
    </section>

    <section id="pro-highlights" class="pro-highlights" aria-labelledby="pro-highlights-title">
      <div class="pro-highlights-head"><div><p class="eyebrow">AVOKADOPRO / STANDALONE</p><h2 id="pro-highlights-title">Highlights.</h2></div><div class="pro-gallery-controls"><button type="button" data-carousel-prev aria-label="Previous Pro highlight">←</button><button type="button" data-carousel-next aria-label="Next Pro highlight">→</button></div></div>
      <div class="pro-highlight-gallery" data-carousel aria-label="avokadoPro design candidates">
        <article class="pro-highlight-card"><div><span>01 / GPU CANDIDATE</span><h3>NVIDIA.<br />For si and play.</h3><p>RTX 5080 Laptop GPU with 16 GB dedicated GPU memory is the P0 candidate. It is not the desktop RTX 5080. Supplier availability and measured performance remain open.</p></div></article>
        <article class="pro-highlight-card"><div><span>02 / MEMORY + STORAGE</span><h3>Room for<br />the project.</h3><p>128 GB system RAM and two 2 TB NVMe SSDs are configuration proposals. Module compatibility and firmware must be confirmed. System RAM is separate from GPU memory.</p></div></article>
        <article class="pro-highlight-card"><div><span>03 / ENCLOSURE TARGET</span><h3>Compact.<br />Still to be proven.</h3><p>220 × 220 × 95 mm is an industrial design target. The reference OEM system does not directly fit this enclosure. Board layout, airflow, thermals, and noise need validation.</p></div></article>
        <article class="pro-highlight-card"><div><span>04 / NEXT VALIDATION</span><h3>Build. Measure.<br />Then decide.</h3><p>First confirm supply and memory compatibility, then test an OEM prototype. Final housing, OS, warranty, price, and delivery will follow evidence. No order has been placed.</p></div></article>
      </div>
      <p class="pro-gallery-hint">Swipe or use the arrows to explore <span aria-hidden="true">↔</span></p><a class="section-next" href="#pro-pairing">Next: see what Mini adds <span aria-hidden="true">↓</span></a>
    </section>

    <section id="pro-pairing" class="pro-pairing" aria-labelledby="pro-pairing-title">
      <figure class="pro-pairing-archive"><img src="/images/avocado-mini-tower20-e3-kit-transparent-v2.png" alt="Archived E3 concept showing four Mini towers and an earlier Hub" loading="lazy" /><figcaption>Archived E3 pairing illustration. This is not the current Pro PC enclosure or a required four-Mini bundle.</figcaption></figure>
      <div><p class="eyebrow">OPTIONAL / MINI PAIRING</p><h2 id="pro-pairing-title">Add the room<br />to the game.</h2><p>Mini is an optional input device in the Pro design. Pairing and multi-device coverage remain separate development and physical validation tasks. The archived image is a past spatial-play concept.</p><dl><div><dt>Pro alone</dt><dd>si, PC games, local services, storage, and audio — design goals</dd></div><div><dt>Mini alone</dt><dd>Standalone R5 goal; external power required; hardware unvalidated</dd></div><div><dt>Pro + Mini</dt><dd>Optional spatial input; no validated device bundle</dd></div></dl><a href="/mini/">Explore avocadoMini <span aria-hidden="true">↗</span></a></div>
    </section>

    <section id="pro-price" class="pro-price" aria-labelledby="pro-price-title">
      <div><p class="eyebrow">AVOKADOPRO / DESIGN TARGET</p><h2 id="pro-price-title">A target,<br />not an offer.</h2><p>The current PC design targets a sale price of ¥800,000 per unit. This is not a confirmed price, procurement budget, or reservation. Mini is optional and is not included.</p></div>
      <div class="pro-price-card">
        <span>avokadoPro · standalone compact PC</span><strong>{proDesign.targetLabel}</strong><small>{proDesign.priceNote}</small><p>{proDesign.status}</p>
        <a href="/preorder/">View current status <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section id="pro-os" class="pro-os" aria-labelledby="pro-os-title">
      <div class="pro-os-orbit" aria-hidden="true"></div>
      <div class="pro-os-copy"><p class="eyebrow">OPERATING FOUNDATION</p><h2 id="pro-os-title">RockstarOS</h2><p>The Pro shipping OS is undecided. Windows is a candidate prototype baseline for PC games; RockstarOS client and native/Linux paths require their own driver, game, update, and recovery tests. Public installation is not yet available.</p><a href="/install/"><span><strong>Open release status</strong><small>ROCKSTAROS / INSTALL</small></span><b aria-hidden="true">↗</b></a></div>
    </section>
    <section class="support-cta" aria-labelledby="pro-support-title"><p>YOUR NEXT STEP</p><h2 id="pro-support-title">See the price. Follow the build.</h2><span>Pro is still in development. Review the design target and open validation work. Hardware, supported games, and si performance are not yet accepted.</span><div><a href="/preorder/">Price & development status →</a><a href={proDesign.source}>Read the source design ↗</a><a href="https://www.instagram.com/kirin.41/" target="_blank" rel="noopener noreferrer">Follow development ↗</a></div></section>
  </main>

  <footer><span>© 2026 AVOKADO LLC</span><a href="/">Mini × Pro</a><a href="/mini/">avocadoMini</a><a href="/install/">RockstarOS</a><a href="/legal/">Sales disclosure</a><a href="/privacy/">Privacy</a></footer>
  <style>
    .pro-hero { height: auto; min-height: 0; display: grid; grid-template-columns: 1fr 1.15fr; gap: 28px; padding: 130px max(24px, 5vw) 70px; }
    .pro-hero-copy { position: static; width: auto; transform: none; align-self: center; grid-column: 1; grid-row: 1; }
    .pro-hero-copy h1 { font-size: clamp(58px, 7vw, 112px); overflow-wrap: anywhere; }
    .pro-design-figure { grid-column: 2; grid-row: 1; margin: 0; align-self: center; }
    .pro-design-figure img { width: 100%; height: auto; }
    .pro-design-figure figcaption, .pro-pairing-archive figcaption { padding: 16px 0; color: #b6c1ca; font-size: 13px; line-height: 1.6; }
    .pro-design-figure a { color: #caf1ff; }
    .pro-hero .film-disclaimer { position: static; grid-column: 1 / -1; margin: 0; color: #e3c98b; }
    .pro-highlight-card { min-height: 420px; height: auto; background: linear-gradient(135deg, #18232c, #080c10); }
    .pro-highlight-card > div { position: relative; inset: auto; padding: 36px; }
    .pro-highlight-card:after { display: none; }
    .pro-pairing-archive { margin: 0; padding: clamp(28px, 5vw, 72px); align-self: center; }
    .pro-pairing-archive img { width: 100%; height: auto; }
    .pro-price-card strong { display: block; font-size: clamp(38px, 5vw, 64px); line-height: 1.1; margin: 22px 0; }
    .pro-price-card small, .pro-price-card p { display: block; line-height: 1.7; color: #bdc8cf; }
    @media (max-width: 800px) {
      .pro-hero { grid-template-columns: 1fr; padding-top: 100px; }
      .pro-design-figure { grid-column: 1; grid-row: 2; }
      .pro-highlight-card > div { padding: 28px; }
    }
  </style>
  <script>import "../../pro-experience.js";</script>
</body>
</html>
