---
import "../../style.css";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#050505" />
  <meta name="description" content="avokadoPro is a standalone game and services Hub. Pair it with avocadoMini for spatial input and a wider play area." />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="avokadoPro — Game and services Hub" />
  <meta property="og:description" content="Games and services on its own. Spatial play when paired with avocadoMini." />
  <meta property="og:url" content="https://avocado-mini.kirin-999.chatgpt.site/pro/" />
  <meta name="twitter:card" content="summary" />
  <link rel="canonical" href="https://avocado-mini.kirin-999.chatgpt.site/pro/" />
  <title>avokadoPro — Game and services Hub</title>
  <link rel="icon" href="/images/avokado-metallic-mark.png" type="image/png" />
  <script is:inline src="/site-enhancements.js" defer></script>
</head>
<body class="pro-product-page">
  <a class="skip" href="#pro-overview">Skip to product</a>
  <header class="site-header pro-header">
    <a class="brand avokado-brand" href="/"><img class="avokado-brand-icon" src="/images/avokado-metallic-mark.png" alt="" aria-hidden="true" />avokado</a>
    <nav class="primary-nav" aria-label="Primary navigation"><a href="#pro-highlights">Highlights</a><a href="#pro-pairing">Pair with Mini</a><a href="#pro-price">Price</a><a href="#pro-os">RockstarOS</a></nav>
    <div class="header-actions"><details class="site-menu"><summary>Menu</summary><div class="site-menu-panel"><p>AVOKADOPRO</p><nav aria-label="Product navigation"><a href="#pro-overview"><span>01</span><strong>Overview</strong><em>Standalone game + services Hub</em></a><a href="#pro-highlights"><span>02</span><strong>Highlights</strong><em>Games · services · compute · audio</em></a><a href="#pro-pairing"><span>03</span><strong>Pair with Mini</strong><em>Add spatial input</em></a><a href="#pro-price"><span>04</span><strong>Price</strong><em>From ¥880,000</em></a><a href="/mini/"><span>05</span><strong>avocadoMini</strong><em>Open the Mini product page</em></a></nav></div></details><a class="header-cta" href="/preorder/">Current status <span aria-hidden="true">↗</span></a></div>
  </header>

  <main>
    <section id="pro-overview" class="pro-hero" aria-labelledby="pro-title">
      <img src="/images/tower20-e3-highlight-edge-hub-v1.png" alt="avokadoPro game Hub connected to four avocadoMini units" fetchpriority="high" />
      <div class="pro-hero-shade" aria-hidden="true"></div>
      <div class="pro-hero-copy">
        <p class="eyebrow">GAME + SERVICES HUB</p>
        <h1 id="pro-title">avokadoPro</h1>
        <p class="pro-hero-line">Games on its own.<br />A bigger world with Mini.</p>
        <p>Run games, local services, compute, storage, and audio without avocadoMini. Add Mini when the experience needs spatial input.</p>
        <a href="#pro-highlights">Explore Pro <span aria-hidden="true">↓</span></a>
      </div>
      <p class="film-disclaimer">Product direction. Concept rendering, not a photograph of production hardware.</p>
    </section>

    <section class="pro-statement" aria-labelledby="pro-statement-title"><p class="eyebrow">ONE HUB / TWO MODES</p><h2 id="pro-statement-title">Independent by design.<br />Expandable by choice.</h2><p>avokadoPro is not an accessory required by Mini. It is its own product—and an optional bridge to a wider spatial system.</p></section>

    <section id="pro-highlights" class="pro-highlights" aria-labelledby="pro-highlights-title">
      <div class="pro-highlights-head"><div><p class="eyebrow">AVOKADOPRO / STANDALONE</p><h2 id="pro-highlights-title">Highlights.</h2></div><div class="pro-gallery-controls"><button type="button" data-carousel-prev aria-label="Previous Pro highlight">←</button><button type="button" data-carousel-next aria-label="Next Pro highlight">→</button></div></div>
      <div class="pro-highlight-gallery" data-carousel aria-label="avokadoPro highlights">
        <article class="pro-highlight-card"><img src="/images/tower20-e3-highlight-edge-hub-v1.png" alt="avokadoPro Hub connected to a spatial system" loading="lazy" /><div><span>01 / GAMES</span><h3>The game<br />lives here.</h3><p>Run approved local game experiences directly through Pro, without requiring Mini.</p></div></article>
        <article class="pro-highlight-card"><img src="/images/avocado-mini-tower20-e3-kit.png" alt="avokadoPro at the center of four Mini units" loading="lazy" /><div><span>02 / SERVICES</span><h3>One Hub.<br />More access.</h3><p>Reach connected services, local assets, and approved experiences through one dedicated product.</p></div></article>
        <article class="pro-highlight-card"><img src="/images/tower20-e3-highlight-edge-hub-v1.png" alt="Close view of the avokadoPro local compute Hub" loading="lazy" /><div><span>03 / LOCAL COMPUTE</span><h3>Close to<br />the experience.</h3><p>Keep active game logic, local compute, storage, and push-to-talk audio near the play area.</p></div></article>
        <article class="pro-highlight-card"><img src="/images/tower20-e3-highlight-200mm-v1.png" alt="Spatial play area expanded with avocadoMini" loading="lazy" /><div><span>04 / EXPANSION</span><h3>Standalone first.<br />Spatial with Mini.</h3><p>Add one or more avocadoMini units only when an experience needs spatial input and wider coverage.</p></div></article>
      </div>
      <p class="pro-gallery-hint">Swipe or use the arrows to explore <span aria-hidden="true">↔</span></p>
    </section>

    <section id="pro-pairing" class="pro-pairing" aria-labelledby="pro-pairing-title">
      <img src="/images/avocado-mini-tower20-e3-kit.png" alt="Four avocadoMini units arranged around avokadoPro" loading="lazy" />
      <div><p class="eyebrow">OPTIONAL / MINI PAIRING</p><h2 id="pro-pairing-title">Add the room<br />to the game.</h2><p>Pair one or more avocadoMini units with Pro to bring spatial input into play. More Minis expand the covered area and improve the quality of the shared experience.</p><dl><div><dt>Pro alone</dt><dd>Games, services, compute, storage, and audio</dd></div><div><dt>Mini alone</dt><dd>Local spatial experiences and expandable coverage</dd></div><div><dt>Pro + Mini</dt><dd>Spatial games across a connected play area</dd></div></dl><a href="/mini/">Explore avocadoMini <span aria-hidden="true">↗</span></a></div>
    </section>

    <section id="pro-price" class="pro-price" aria-labelledby="pro-price-title">
      <div><p class="eyebrow">AVOKADOPRO / REFERENCE PRICE</p><h2 id="pro-price-title">Start with Pro.</h2><p>avokadoPro works on its own. avocadoMini is optional and sold separately.</p></div>
      <div class="pro-price-card">
        <div class="currency-switch" role="group" aria-label="Display currency"><button type="button" class="currency-toggle-button is-active" data-currency="jpy" aria-pressed="true">JPY</button><button type="button" class="currency-toggle-button" data-currency="usd" aria-pressed="false">USD</button></div>
        <span>avokadoPro · standalone Hub</span><strong class="price-value" data-price-jpy="From ¥880,000" data-price-usd="From US$5,800">From ¥880,000</strong><em class="price-conversion" data-conversion-jpy="Approx. US$5,800" data-conversion-usd="Approx. ¥880,000">Approx. US$5,800</em><small>Reference price · tax and shipping excluded</small>
        <a href="/preorder/">View current status <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section id="pro-os" class="pro-os" aria-labelledby="pro-os-title">
      <div class="pro-os-orbit" aria-hidden="true"></div>
      <div class="pro-os-copy"><p class="eyebrow">OPERATING FOUNDATION</p><h2 id="pro-os-title">RockstarOS</h2><p>System software for approved hardware, local services, and connected experiences. Public installation is not yet available.</p><a href="/install/"><span><strong>Open release status</strong><small>ROCKSTAROS / INSTALL</small></span><b aria-hidden="true">↗</b></a></div>
    </section>
  </main>

  <footer><span>© 2026 avokadinc</span><a href="/">Mini × Pro</a><a href="/mini/">avocadoMini</a><a href="/install/">RockstarOS</a><a href="/legal/">Sales disclosure</a><a href="/privacy/">Privacy</a></footer>
  <script>
    const buttons = [...document.querySelectorAll('.currency-toggle-button')];
    const value = document.querySelector('.price-value');
    const conversion = document.querySelector('.price-conversion');
    function setCurrency(currency) {
      const selected = currency === 'usd' ? 'usd' : 'jpy';
      const key = selected === 'usd' ? 'Usd' : 'Jpy';
      buttons.forEach((button) => { const active = button.dataset.currency === selected; button.classList.toggle('is-active', active); button.setAttribute('aria-pressed', String(active)); });
      if (value) value.textContent = value.dataset[`price${key}`];
      if (conversion) conversion.textContent = conversion.dataset[`conversion${key}`];
      try { localStorage.setItem('avokado-price-currency', selected); } catch {}
    }
    buttons.forEach((button) => button.addEventListener('click', () => setCurrency(button.dataset.currency)));
    let initialCurrency = 'jpy';
    try { initialCurrency = localStorage.getItem('avokado-price-currency') || 'jpy'; } catch {}
    setCurrency(initialCurrency);
  </script>
</body>
</html>
