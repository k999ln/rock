---
import "../../style.css";
import "../../pro-experience.css";
import { proDesign } from "../../pro-design.js";
import ProAssemblyWorkbench from "../../components/ProAssemblyWorkbench.astro";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f8f9f7" />
  <meta name="description" content="Meet avocadoPro, the dedicated AI PC concept. Explore real component references, configure your build, and join the first-build interest list." />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="avocadoPro — Meet Your AI PC" />
  <meta property="og:description" content="Explore the AI PC, shape a concept configuration, and join the first-build interest list." />
  <meta property="og:url" content="https://avocadopro.si/" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href="https://avocadopro.si/" />
  <link rel="icon" href="/images/avokado-metallic-mark.png" type="image/png" />
  <title>avocadoPro — Meet Your AI PC</title>
  <script is:inline src="/site-enhancements.js" defer></script>
</head>
<body class="pro-product-page pro-experience-page">
  <a class="skip" href="#pro-customize">Skip to configuration</a>
  <header class="site-header pro-header">
    <a class="brand avokado-brand" href="https://avoado.si/"><img class="avokado-brand-icon" src="/images/avokado-metallic-mark.png" alt="" aria-hidden="true" />avokado<span class="pro-brand-suffix">/ Pro</span></a>
    <nav class="primary-nav" aria-label="Product navigation"><a href="#purpose">Purpose</a><a href="#pro-build">The Pro</a><a href="#pro-customize">Explore parts</a><a href="#pro-configuration">Your build</a></nav>
    <div class="header-actions"><details class="site-menu"><summary>Menu</summary><div class="site-menu-panel"><p>AVOCADOPRO</p><nav aria-label="Product navigation"><a href="#pro-build"><strong>Meet the Pro</strong></a><a href="#pro-customize"><strong>Explore parts</strong></a><a href="#pro-configuration"><strong>Your build</strong></a><a href="#pro-interest"><strong>First-build interest</strong></a><a href="https://avocadomini.si/"><strong>avocadoMini</strong></a><a href="https://avoado.si/"><strong>Sky & services</strong></a></nav></div></details><a class="header-cta" href="#pro-interest">Join first-build list <span aria-hidden="true">↗</span></a></div>
  </header>

  <main>


    <section id="pro-build" class="pro-build" aria-labelledby="pro-build-title">
      <ProAssemblyWorkbench />
      <section id="pro-interest" class="pro-interest" aria-labelledby="pro-interest-title"><div><p class="pro-kicker">04 / FIRST-BUILD INTEREST · UNITED STATES FIRST</p><h2 id="pro-interest-title">Help shape the first Pro.</h2><p>Share your configuration and what you want to make. avokado LLC is preparing a one-at-a-time US build-to-order launch. We will contact you when the exact parts, a tested prototype, price, shipping window, and purchase terms are ready.</p><ol class="pro-interest-steps"><li><strong>01 · Configure</strong><span>Choose a concept build and tell us your use case.</span></li><li><strong>02 · Prove the hardware</strong><span>We validate the exact parts, fit, cooling, software, and supply on a real machine.</span></li><li><strong>03 · Review your offer</strong><span>See the final configuration, total price, shipping window, warranty, and return terms before deciding.</span></li><li><strong>04 · Build and ship</strong><span>After an accepted paid order, the machine is assembled, tested, packed, and tracked to delivery.</span></li></ol><p class="pro-interest-current">Selected: <strong data-interest-configuration>Studio / Value</strong></p><p class="pro-interest-honesty">The US is the first planned sales region. Joining the list is free. It is not an order or a reservation; no payment or delivery promise is being offered yet.</p></div><div class="pro-interest-panel"><form data-pro-interest-form><label>Email for a reply<input type="email" name="email" autocomplete="email" required maxlength="254" placeholder="you@example.com" /></label><label>Country or region <span>(optional)</span><input type="text" name="region" autocomplete="country-name" maxlength="80" placeholder="Where would you buy it?" /></label><label>What would you build with it? <span>(optional)</span><textarea name="note" rows="3" maxlength="500" placeholder="Tell us your AI workflow and why you need a dedicated PC."></textarea></label><input class="pro-honeypot" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" /><label class="pro-interest-consent"><input type="checkbox" name="contactConsent" required /><span>I agree to be contacted about this avocadoPro configuration. I understand this is not an order or payment. <a href="/privacy/">Privacy details</a>.</span></label><button type="submit" data-interest-submit disabled>Join the first-build list ↗</button><p data-interest-status role="status" aria-live="polite">Checking availability…</p></form><div data-interest-receipt class="pro-interest-receipt" hidden><h3>Request received.</h3><p>Keep this receipt to remove your request later. No payment was taken.</p><dl><div><dt>Request ID</dt><dd data-receipt-id></dd></div><div><dt>Removal code</dt><dd data-receipt-code></dd></div></dl><button type="button" data-remove-interest>Remove my request</button><p data-remove-status role="status" aria-live="polite"></p></div></div></section>
    </section>

    <section class="pro-interest"><div><p class="pro-kicker">DESIGN TARGET / NOT A SALES OFFER</p><h2>{proDesign.targetLabel}</h2><p>{proDesign.priceNote} Mini is optional and sold separately. Hardware has not yet been assembled or accepted.</p><a href={proDesign.source}>Read the source design ↗</a></div></section>
  </main>
  <footer><span>© 2026 avokado</span><nav aria-label="Footer navigation"><a href="https://avoado.si/">Sky & services</a><a href="https://avocadomini.si/">avocadoMini</a><a href="https://avocadopro.si/">avocadoPro</a><a href="/privacy/">Privacy</a></nav></footer>
  <script>import "../../pro-experience.js";</script>
</body>
</html>
