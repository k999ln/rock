  "findings": [
    {
      "implemented": "Two localStorage keys; input draft capped at 3000 characters, new board text 160, loaded board max100; clipboard draft and JSON board export; no fetch/auth/job connection in pro-os.js.",
      "gap": "Existing board export omits draft/raw original; load filters/slices malformed/excess entries. New migration must preserve raw original before parsing and never silently promote done to completed."
    },
    {
      "implemented": "Portable runtime declares existing history/jobs/workflow, owner authorization, CAS and UNKNOWN recovery; work store creates once by ID.",
      "gap": "POST replay compares title/template only; full import digest/provenance and owner-bound mapping are not established."
    },
    {
      "implemented": "Domain router serves Pro assets and /build on avocadopro.si.",
      "gap": "Inspected router has no common-auth migration gateway; do not infer cookie sharing or permit arbitrary CORS. Explicit file export/import is first viable boundary."
    },
    {
      "implemented": "Sales readiness schema/checker and three negative/synthetic tests exist.",
      "gap": "12/12 sales gates false; candidate pro-studio-16, silver A4-H2O, exact BOM/physical compatibility unaccepted; paid/shipped orders0. Boolean checker does not verify evidence hash/expiry; synthetic ready is mathematical only."
    },
    {
      "gap": "Referenced data/rockstaros-full-function-coverage.json absent at inspection; no 180-item Pro coverage asserted."
    }
  ],
