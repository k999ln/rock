'use client';
import {useRef,useState} from 'react';
import type {RemixFile,RemixSlots} from '@/lib/eve-remix';
import styles from './eve-remix.module.css';
/** Pointer release and named controls share the same selection-only command. */
export default function EveRemixStage({files,slots,busy,onPlace,onRemove}:{files:RemixFile[];slots:RemixSlots;busy:boolean;onPlace:(index:number,side:0|1)=>void;onRemove:(index:number)=>void}){
 const [focused,setFocused]=useState<number|null>(null),[moving,setMoving]=useState<{index:number;x:number;y:number}|null>(null);
 const [over,setOver]=useState<number|null>(null);
 const drag=useRef<{index:number;x:number;y:number}|null>(null);
 return <section className={styles.materials} aria-label="原本の素材棚と掛け合わせ先" data-remix-surface="materials"><header><span className={styles.eyebrow}>ORIGINALS</span><h3>素材をスライドして、もう一つに重ねる。</h3><p>カードの名前をつかんで別のカードに重ねると、2つが素材A・Bに入ります。元の資料は残ります。</p></header>
 <div className={styles.materialShelf}>{files.map((file,index)=><article key={index} className={styles.materialCard} data-remix-object={`file-${index}`} data-selected={slots.includes(index)||undefined} data-over={over===index||undefined} onPointerDown={e=>{if(busy||(e.target as HTMLElement).closest('button'))return;drag.current={index,x:e.clientX,y:e.clientY};e.currentTarget.setPointerCapture(e.pointerId);}} onPointerMove={e=>{if(drag.current&&Math.hypot(e.clientX-drag.current.x,e.clientY-drag.current.y)>8){setMoving({index,x:e.clientX,y:e.clientY});const hit=document.elementFromPoint(e.clientX,e.clientY)?.closest<HTMLElement>('[data-remix-object]');const other=hit?.dataset.remixObject?.match(/^file-(\d+)$/);setOver(other&&Number(other[1])!==index?Number(other[1]):null);}}} onPointerCancel={()=>{drag.current=null;setMoving(null);setOver(null);}} onPointerUp={e=>{const d=drag.current;drag.current=null;setMoving(null);setOver(null);if(!d||busy)return;const hit=document.elementFromPoint(e.clientX,e.clientY);const other=hit?.closest<HTMLElement>('[data-remix-object]')?.dataset.remixObject?.match(/^file-(\d+)$/);if(other&&Number(other[1])!==d.index){onPlace(d.index,0);onPlace(Number(other[1]),1);return;}const target=hit?.closest<HTMLElement>('[data-remix-file-slot]');if(target){const side=Number(target.dataset.remixFileSlot);if(side===0||side===1)onPlace(d.index,side);}else if(Math.abs(e.clientX-d.x)>45&&Math.abs(e.clientY-d.y)<70)onPlace(d.index,e.clientX>d.x?1:0);else setFocused(d.index);}}>
 <span className={styles.eyebrow}>⠿ スライド · 資料 {index+1}</span><strong>{file.name}</strong><small>{file.text.length.toLocaleString()}文字 · 原本</small><div className={styles.row}><button type="button" disabled={busy} aria-label={`${file.name}を素材Aに置く`} data-eve-action="place-source-a" onClick={()=>onPlace(index,0)}>Aへ置く</button><button type="button" disabled={busy} aria-label={`${file.name}を素材Bに置く`} data-eve-action="place-source-b" onClick={()=>onPlace(index,1)}>Bへ置く</button><button type="button" disabled={busy} aria-label={`${file.name}を素材棚から外す`} onClick={()=>{onRemove(index);setFocused(null);}}>外す</button></div></article>)}</div>
 {files.length===0&&<p className={styles.empty}>資料をここへ置くと、素材カードになります。</p>}
 <div className={styles.sourceSlots}>{([0,1] as const).map(side=>{const index=slots[side],file=index===null?undefined:files[index];return <div key={side} className={styles.sourceSlot} data-remix-file-slot={side}><button type="button" className={styles.placeTarget} disabled={busy||focused===null||!files[focused]} onClick={()=>{if(focused!==null)onPlace(focused,side);}} aria-label={`選択した素材を${side===0?'A':'B'}に置く`}><span>素材 {side===0?'A':'B'}</span><strong>{file?.name??'ここへ重ねる'}</strong></button>{file&&<details><summary aria-label={`元の資料${side===0?'A':'B'}を読む`}>元の資料{side===0?'A':'B'}を読む</summary><pre className={styles.sourceText}>{file.text}</pre></details>}</div>;})}</div>
 {moving&&<div className={styles.dragGhost} style={{left:moving.x-80,top:moving.y-28}}>{files[moving.index]?.name}</div>}
 </section>;
}
