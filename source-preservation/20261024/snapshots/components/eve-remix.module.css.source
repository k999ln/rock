.panel{padding:20px;border:1px solid #d8dfd3;border-radius:18px;background:#f8faf4;color:#243d32;margin:16px 0}.panel h3{margin:0 0 8px;font-size:19px}.panel p{font-size:13px;line-height:1.7}.panel label{display:grid;gap:6px;margin:12px 0;font-size:13px}.panel input,.panel textarea,.panel select{border:1px solid #b9c8bc;border-radius:10px;padding:10px;background:white;color:#243d32;width:100%;box-sizing:border-box}.panel button,.panel a{padding:10px 14px;min-height:44px;border-radius:10px;border:1px solid #9fb5a5;cursor:pointer;display:inline-flex;align-items:center;gap:6px}.panel button:disabled{opacity:.45;cursor:not-allowed}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.cards{display:flex;gap:12px;overflow-x:auto;padding:12px 0}.card{flex:0 0 190px;background:white;border:1px solid #b4c8b8;border-radius:14px;padding:14px;touch-action:pan-y;user-select:none}.card strong{display:block}.card small{display:block;font-size:11px;margin:8px 0;overflow-wrap:anywhere}.slots{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:center;margin:16px 0}.slot{min-height:86px;border:2px dashed #a8bdaa;border-radius:14px;display:grid;place-items:center;padding:10px;text-align:center;font-size:13px}.result{white-space:pre-wrap;overflow-wrap:anywhere;background:white;border-radius:12px;padding:16px;font-size:14px}.notice{display:block;margin:12px 0;font-size:13px}.panel :focus-visible{outline:3px solid #aa753c;outline-offset:3px}.files{list-style:none;padding:0}.files li{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 0;font-size:13px}
.surfaceBar{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;padding:22px 6px}.surfaceBar h2{margin:7px 0;font-size:26px;letter-spacing:-.04em}.surfaceBar button{border:1px solid #b9c9bb;border-radius:999px;padding:12px 20px;min-height:48px;background:#fff;color:#315b4d;cursor:pointer}.surfaceBar button[aria-pressed=true]{background:#294d40;color:white}.eyebrow{display:block;font-size:10px;letter-spacing:.15em;font-weight:700;color:#658171;margin-bottom:8px}.miniSurface .panel{padding:24px;border-radius:26px;background:linear-gradient(145deg,#f1f5ec,#f9fbf6)}.workbench{display:grid;grid-template-columns:minmax(220px,1fr) minmax(240px,.9fr) minmax(280px,1.15fr);gap:24px;align-items:start}.materials h3,.command h3,.output h3{font-size:20px;line-height:1.4}.materialShelf{display:flex;gap:12px;flex-wrap:wrap;margin:18px 0}.materialCard{background:#fff;border:1px solid #b9c9bb;border-radius:16px;padding:16px;min-width:0;flex:1 1 180px;touch-action:pan-y;user-select:none;box-shadow:0 6px 20px #294d4008}.materialCard[data-selected]{border-color:#416c55;box-shadow:0 0 0 2px #416c5515}.materialCard strong,.materialCard small{display:block;overflow-wrap:anywhere}.materialCard small{font-size:11px;color:#658171;margin:8px 0}.sourceSlots{display:grid;gap:14px}.sourceSlot{border:2px dashed #a9bda9;border-radius:20px;background:#fff9;padding:14px;min-height:112px}.panel .placeTarget{display:grid;width:100%;border:0;background:none;text-align:left;gap:6px;min-height:74px}.placeTarget span{font-size:12px;color:#658171}.placeTarget strong{font-size:18px;overflow-wrap:anywhere}.sourceSlot details{font-size:12px}.sourceText{white-space:pre-wrap;overflow-wrap:anywhere;max-height:240px;overflow:auto;font-size:13px;padding:10px;background:#f7f9f3;border-radius:10px}.command,.output{background:#fff9;border:1px solid #d6e1d2;border-radius:22px;padding:20px;min-width:0}.command textarea{font-size:17px;line-height:1.7}.panel .primaryAction{background:#315b4d;color:white;border-color:#315b4d;min-height:56px;font-size:16px;font-weight:650;width:100%;justify-content:center}.output textarea{font-size:15px;line-height:1.8;min-height:300px}.empty{padding:18px;color:#6a7c6b;line-height:1.8;border:1px dashed #c5d2c0;border-radius:18px}.executionSettings,.importer{margin-top:18px}.panel summary{padding:14px 0;min-height:44px;cursor:pointer}.panel .executionSettings button{margin:8px 0}.dragGhost{position:fixed;z-index:9999;pointer-events:none;padding:18px 24px;max-width:240px;border-radius:16px;background:#315b4d;color:white;box-shadow:0 12px 32px #0003;font-size:16px}.surfaceNote{font-size:12px;line-height:1.8;color:#6b786b;padding:12px}.miniSurface .card{flex-basis:240px;padding:20px;border-radius:20px}.miniSurface .slot{min-height:120px}.miniSurface button{min-height:50px}.screenSurface .workbench{grid-template-columns:1fr}.screenSurface .sourceSlots{grid-template-columns:1fr 1fr}@media(max-width:1050px){.workbench{grid-template-columns:1fr 1fr}.output{grid-column:1/-1}}@media(max-width:640px){.workbench{grid-template-columns:1fr}.miniSurface .panel{padding:16px}.sourceSlots{grid-template-columns:1fr 1fr;gap:8px}.sourceSlot{padding:8px;min-height:104px}.materialShelf{flex-wrap:nowrap;overflow:auto;padding:6px 2px}.materialCard{flex:0 0 240px}.surfaceBar h2{font-size:23px}.sourceText{max-width:100%;font-size:12px}.panel .placeTarget strong{font-size:15px}.command,.output{padding:18px}.output{grid-column:auto}}
@media(min-width:641px){.materialShelf{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.materialCard{padding:12px}.materialCard .row{gap:6px}.materialCard .row button{padding:8px 10px}.sourceSlots{grid-template-columns:1fr 1fr;gap:10px}.sourceSlot{padding:8px}.sourceSlot .placeTarget{padding:8px;min-width:0}.placeTarget strong{font-size:15px}}.panel .placeTarget:disabled{opacity:1;cursor:default}
.combinedRole{margin:18px 0;padding:20px;background:#ffffffbf;border:1px solid #c3d4c1;border-radius:20px}.combinedRole h4{font-size:22px;margin:8px 0;overflow-wrap:anywhere}.combinedRole p{margin:8px 0}

.materialCard{touch-action:none;cursor:grab}.materialCard:active{cursor:grabbing}.materialCard[data-over]{outline:3px solid #416c55;background:#e7f3df;transform:scale(1.025)}.materialCard{transition:transform .12s,background .12s}.materialCard button{touch-action:manipulation}

.materials{min-width:0}.materials header p{overflow-wrap:anywhere;white-space:normal}.materialShelf{max-width:100%}

.otherWorkspace{margin:28px 0}.otherWorkspace>summary{font-size:14px;color:#85766a;padding:20px 4px;border-top:1px solid #e2d8cb;cursor:pointer}
