diff --git a/components/lazy-workspace-section.tsx b/components/lazy-workspace-section.tsx
new file mode 100644
index 0000000..f7de94d
--- /dev/null
+++ b/components/lazy-workspace-section.tsx
@@ -0,0 +1,27 @@
+'use client';
+
+import { createElement, useEffect, useState, type ComponentType } from 'react';
+
+type Props<P extends object> = {
+  load: () => Promise<{ default: ComponentType<P> }>;
+  componentProps: P;
+};
+
+/** Handle loading failures without intercepting a mounted work component's lifecycle. */
+export default function LazyWorkspaceSection<P extends object>({load, componentProps}: Props<P>) {
+  const [View, setView] = useState<ComponentType<P> | null>(null);
+  const [failed, setFailed] = useState(false);
+  const [attempt, setAttempt] = useState(0);
+  useEffect(() => {
+    let active = true;
+    void Promise.resolve().then(load).then(module => {
+      if (active) setView(() => module.default);
+    }).catch(() => {
+      if (active) setFailed(true);
+    });
+    return () => { active = false; };
+  }, [load, attempt]);
+  if (failed) return <div role="alert">この画面を読み込めませんでした。会話の入力はこのまま残っています。接続を確かめて再試行してください。繰り返す場合は、未送信の入力を控えてからページを再読み込みしてください。 <button type="button" onClick={() => { setFailed(false); setAttempt(value => value + 1); }}>もう一度読み込む</button></div>;
+  if (!View) return <output>読み込んでいます…</output>;
+  return createElement(View, componentProps);
+}
