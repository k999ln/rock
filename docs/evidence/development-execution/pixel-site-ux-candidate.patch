index baf374b..6e2ddfc 100644
--- a/lib/eve-news-feed.ts
+++ b/lib/eve-news-feed.ts
@@ -13,0 +14,6 @@ export const EVE_NEWS_PROVIDER = 'GDELT DOC 2.0';
+/** Bounded, explicitly stale recovery; future and invalid timestamps are rejected. */
+export function newsSnapshotUsable(fetchedAt: string, now: number) {
+  const at = Date.parse(fetchedAt);
+  return Number.isFinite(at) && at <= now && now - at < 14 * 24 * 60 * 60_000;
+}
