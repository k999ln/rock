+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { runInNewContext } from 'node:vm';
+import ts from 'typescript';
+import * as feed from '../lib/eve-news-feed.ts';
+const source=readFileSync(new URL('../app/api/news/feed/route.ts',import.meta.url),'utf8');
+const seed=JSON.parse(readFileSync(new URL('../data/eve-news-seed-20261021.json',import.meta.url),'utf8'));
+const liveSeed=JSON.parse(readFileSync(new URL('../data/sky-live-news-seed.json',import.meta.url),'utf8'));
+function route(input, fetcher=async()=>{throw Error('offline fixture');}){
+ const clock=typeof input==='number'?{now:input}:input;
+ const exports={}; class ClockDate extends Date { constructor(...args){super(...(args.length?args:[clock.now]));} static now(){return clock.now;} }
+ const compiled=ts.transpileModule(source,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.CommonJS,esModuleInterop:true}}).outputText;
+ runInNewContext(compiled,{exports,URL,AbortSignal,Date:ClockDate,fetch:fetcher,require(name){
+  if(name==='next/server')return {NextResponse:{json:(body,options={})=>({body,status:options.status??200,headers:options.headers})}};
+  if(name==='@/lib/eve-news-feed')return feed;
+  if(name==='@/data/eve-news-seed-20261021.json')return seed;
+  if(name==='@/data/sky-live-news-seed.json')return liveSeed;
+  throw Error('unexpected dependency');
+ }}); return exports.GET;
+}
+void test('provider outage returns bounded historical snapshot marked stale and preserves its original time',async()=>{
+ const get=route(Date.parse('2026-10-29T12:00:00Z'));
+ const result=await get({url:'https://fixture.invalid/api/news/feed?topic=all'});
+ assert.equal(result.status,200);assert.equal(result.body.stale,true);
+ assert.equal(result.body.fetchedAt,liveSeed.fetchedAt);assert.ok(result.body.articles.length);
+});
+void test('a recent successful response remains preferred over a week-old snapshot during outage',async()=>{
+ const clock={now:Date.parse('2026-10-29T10:00:00Z')};let fail=false;
+ const get=route(clock,async()=>{if(fail)throw Error('offline fixture');return {ok:true,json:async()=>({articles:[{url:'https://publisher.invalid/story',title:'A fixture story',seendate:'20261029T090000Z'}]})};});
+ const req={url:'https://fixture.invalid/api/news/feed?topic=all'};
+ const fresh=await get(req);assert.equal(fresh.body.stale,false);
+ clock.now+=2*60*60_000;fail=true;
+ const recovered=await get(req);
+ assert.equal(recovered.status,200);assert.equal(recovered.body.stale,true);
+ assert.equal(recovered.body.fetchedAt,fresh.body.fetchedAt);
+ assert.equal(recovered.body.articles[0].url,'https://publisher.invalid/story');
+});
+void test('provider outage cannot turn an expired historical snapshot into current news',async()=>{
+ const get=route(Date.parse('2026-11-10T12:00:00Z'));
+ const result=await get({url:'https://fixture.invalid/api/news/feed?topic=all'});
+ assert.equal(result.status,503);assert.equal(result.body.articles,undefined);
+});
diff --git a/tests/eve-results-guidance.test.mjs b/tests/eve-results-guidance.test.mjs
new file mode 100644
index 0000000..a622873
--- /dev/null
+++ b/tests/eve-results-guidance.test.mjs
@@ -0,0 +1,27 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { eveResultsGuidance, eveResultsScopeVerified, eveResultsResponseCurrent } from '../lib/eve-results-guidance.ts';
+
+test('result guidance never describes an unknown connection as an empty account', () => {
+  const base = { online: true, runtimeNotice: '', hasVisibleResults: false, selectedThread: false, scopeVerified: true };
+  assert.match(eveResultsGuidance({ ...base, online: false }), /未確認/);
+  assert.match(eveResultsGuidance({ ...base, runtimeNotice: 'unavailable' }), /判断できません/);
+  assert.match(eveResultsGuidance({ ...base, scopeVerified: false }), /未確認/);
+  assert.match(eveResultsGuidance(base), /現在読み込んだ端末報告/);
+  assert.match(eveResultsGuidance({ ...base, selectedThread: true }), /この会話/);
+  assert.equal(eveResultsGuidance({ ...base, hasVisibleResults: true }), '');
+});
+
+test('an old response or another owner cannot verify the current conversation', () => {
+  const old = { owner: 'owner-a', thread: 'thread-a' };
+  assert.equal(eveResultsScopeVerified(old, 'owner-a', 'thread-b'), false);
+  assert.equal(eveResultsScopeVerified(old, 'owner-b', 'thread-a'), false);
+  assert.equal(eveResultsScopeVerified(null, 'owner-a', 'thread-a'), false);
+  assert.equal(eveResultsScopeVerified(old, 'owner-a', 'thread-a'), true);
+});
+
+test('A to B to A never accepts the older A response', () => {
+  assert.equal(eveResultsResponseCurrent('A', 'B', 1, 2), false);
+  assert.equal(eveResultsResponseCurrent('A', 'A', 1, 3), false);
+  assert.equal(eveResultsResponseCurrent('A', 'A', 3, 3), true);
+});
