+const json=x=>({ok:true,json:async()=>x});
+const session=(id,content)=>({ownerUserId:'fixture-owner',session:{id,messages:[{id:'m',side:'me',text:content}]},before:null});
+window.fetch=async (url)=>{
+ const u=new URL(url,location.origin);
+ if(u.pathname==='/api/eve/history'&&u.searchParams.has('id')){const id=u.searchParams.get('id');return json(session(id,`fixture-${id}-${++serial}`));}
+ if(u.pathname==='/api/eve/history'&&u.searchParams.has('cursor'))return {ok:false,status:500,json:async()=>({error:'合成した履歴操作エラー'})};
+ if(u.pathname==='/api/eve/history'){if(authFailureNext){return {ok:false,status:401,json:async()=>({error:'fixture auth'})};}if(failHistoryNext){failHistoryNext=false;throw new DOMException('fixture abort','AbortError');}return json({ownerUserId:'fixture-owner',items:[session('A','Fixture A'),session('B','Fixture B')],cursor:'fixture-next'});}
