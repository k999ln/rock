+void test('returning from the MCP view protects an unsent request', async () => {
+  const h = harness({ query: 'mode=tools' }); await h.flush();
+  assert.ok(h.nodes().some((n) => n.type === 'a' && n.props.href === '/os/eve' && n.props['aria-label'] === 'Eveに戻り、保存済みの会話を履歴から開く'));
+  h.input('Synthetic MCP draft');
+  const event = await h.shellLink('/os/eve');
+  assert.equal(event.defaultPrevented, true);
+  assert.ok(h.text().includes('未送信の依頼があります'));
+  await h.click('入力を続ける');
+  assert.equal(h.nodes().find((n) => n.type === 'textarea').props.value, 'Synthetic MCP draft');
+  assert.equal(h.routes.length, 0);
+});
+
+void test('returning from the MCP view is blocked while the existing work is running', async () => {
+  const h = harness({ saved: [session()], query: `mode=tools&tool=rockstar-amc&thread=${id}` }); await h.flush();
+  h.nodes().find((n) => n.type === 'AMC').props.onRunningChange(true); await h.flush();
+  const event = await h.shellLink('/os/eve');
+  assert.equal(event.defaultPrevented, true);
+  assert.equal(h.routes.length, 0);
+  assert.ok(h.nodes().some((n) => n.type === 'AMC'));
+});
+
