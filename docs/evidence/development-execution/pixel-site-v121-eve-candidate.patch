index 0000000..7bae749
--- /dev/null
+++ b/tests/eve-results-guidance.test.mjs
@@ -0,0 +1,27 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { eveResultsGuidance, eveResultsScopeVerified, eveResultsResponseCurrent } from '../lib/eve-results-guidance.ts';
+
+void test('result guidance never describes an unknown connection as an empty account', () => {
+  const base = { online: true, runtimeNotice: '', hasVisibleResults: false, selectedThread: false, scopeVerified: true };
+  assert.match(eveResultsGuidance({ ...base, online: false }), /未確認/);
+  assert.match(eveResultsGuidance({ ...base, runtimeNotice: 'unavailable' }), /判断できません/);
+  assert.match(eveResultsGuidance({ ...base, scopeVerified: false }), /未確認/);
+  assert.match(eveResultsGuidance(base), /現在読み込んだ端末報告/);
+  assert.match(eveResultsGuidance({ ...base, selectedThread: true }), /この会話/);
+  assert.equal(eveResultsGuidance({ ...base, hasVisibleResults: true }), '');
+});
+
+void test('an old response or another owner cannot verify the current conversation', () => {
+  const old = { owner: 'owner-a', thread: 'thread-a' };
+  assert.equal(eveResultsScopeVerified(old, 'owner-a', 'thread-b'), false);
+  assert.equal(eveResultsScopeVerified(old, 'owner-b', 'thread-a'), false);
+  assert.equal(eveResultsScopeVerified(null, 'owner-a', 'thread-a'), false);
+  assert.equal(eveResultsScopeVerified(old, 'owner-a', 'thread-a'), true);
+});
+
+void test('A to B to A never accepts the older A response', () => {
+  assert.equal(eveResultsResponseCurrent('A', 'B', 1, 2), false);
+  assert.equal(eveResultsResponseCurrent('A', 'A', 1, 3), false);
+  assert.equal(eveResultsResponseCurrent('A', 'A', 3, 3), true);
+});
