+import React from 'react';
+import {createRoot} from 'react-dom/client';
+import Eve from '@fixture-eve';
+let deferred=null, holdNext=false, serial=0;
+const json=x=>({ok:true,json:async()=>x});
+const session=(id,content)=>({ownerUserId:'fixture-owner',session:{id,messages:[{id:'m',side:'me',text:content}]},before:null});
+window.fetch=async (url)=>{
+ const u=new URL(url,location.origin);
+ if(u.pathname==='/api/eve/history'&&u.searchParams.has('id')){const id=u.searchParams.get('id');return json(session(id,`fixture-${id}-${++serial}`));}
+ if(u.pathname==='/api/eve/history')return json({ownerUserId:'fixture-owner',items:[session('A','Fixture A'),session('B','Fixture B')],cursor:null});
+ if(u.pathname==='/api/eve/device-sync')return json({ownerUserId:'fixture-owner',jobs:[],devices:[]});
+ if(u.pathname==='/api/eve/runtime'){
+  if(holdNext){holdNext=false;return await new Promise(resolve=>{deferred=()=>resolve(json({ownerUserId:'fixture-owner',devices:[],executions:[],pending:[]}));window.dispatchEvent(new Event('fixture-held')); });}
+  return json({ownerUserId:'fixture-owner',devices:[],executions:[],pending:[]});
+ }
+ throw Error('fixture denies all other requests');
+};
+function Controls(){const [held,setHeld]=React.useState(false);React.useEffect(()=>{const f=()=>setHeld(true);window.addEventListener('fixture-held',f);return()=>window.removeEventListener('fixture-held',f)},[]);return <div style={{padding:12,background:'#e8f1e8'}}><strong>隔離fixture・ネットワーク送信なし</strong><output>{held?'応答保留中':'待機中'}</output><button onClick={()=>{holdNext=true}}>次の応答を保留</button><button onClick={()=>{if(deferred){deferred();deferred=null;setHeld(false)}}}>保留した応答を返す</button></div>}
+createRoot(document.getElementById('root')).render(<><Controls/><Eve/></>);
