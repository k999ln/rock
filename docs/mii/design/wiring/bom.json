  "connections": [
    {
      "id": "W01",
      "endpoints": "C01固定cable → H01 U1 USB-C receptacle",
      "signal": "1.5m USB-C、video/audio/bus power",
      "constraint": "完成品を直結、splitterなし",
      "status": "design_only"
    },
    {
      "id": "W02",
      "endpoints": "E01固定USB-C plug → H01 U2 USB-C receptacle",
      "signal": "USB data＋adapter bus power",
      "constraint": "U1と異なる空きUSB-C。Mac↔Piの給電線ではない",
      "status": "design_only"
    },
    {
      "id": "W03",
      "endpoints": "E01 RJ45 → N01 RJ45",
      "signal": "E02、8接点完成Cat6 patch 2m",
      "constraint": "1000BASE-T交渉を確認、PoEなし、自作結線なし",
      "status": "design_only"
    },
    {
      "id": "W04",
      "endpoints": "P01固定USB-C plug → N01 USB-C POWER",
      "signal": "5.1V/5A rail、純正cable",
      "constraint": "Piに必要な5A供給。27Wは商品名、5.1×5=25.5Wが該当rail定格",
      "status": "design_only"
    },
    {
      "id": "W05",
      "endpoints": "C02 camera 15pin → N01 CAM/DISP1 22pin",
      "signal": "F01、CSI-2＋制御/給電の公式配線",
      "constraint": "両側無通電で挿抜。15-15同梱cableはPi 5に使わない",
      "status": "design_only"
    },
    {
      "id": "W06",
      "endpoints": "T01 fan plug → N01 FAN 4pin",
      "signal": "同梱key付きcable、5V/PWM/tach",
      "constraint": "GPIO 40pinに挿さない。key方向を確認し無理に押さない",
      "status": "design_only"
    },
    {
      "id": "W07",
      "endpoints": "S01 microSD → N01 microSD slot",
      "signal": "storage、電源offで着脱",
      "constraint": "起動媒体は電源投入前に装着",
      "status": "design_only"
    },
    {
      "id": "W09",
      "endpoints": "R01 USB-C plug → H01空きUSB-C、S01 → R01 microSD slot",
      "signal": "初期設定時のみ、USB給電",
      "constraint": "USB-A側は同時接続しない。書込検証後ejectしてS01をPiへ移す",
      "status": "design_only"
    },
    {
      "id": "W08",
      "endpoints": "H01 HDMI → projector HDMI IN",
      "signal": "D01、2m HDMI、条件付き",
      "constraint": "exact型番・入力・EDID確認後。初期目標1080p60、実交渉を記録",
      "status": "design_only"
    }
  ],
  "unconnected": [
