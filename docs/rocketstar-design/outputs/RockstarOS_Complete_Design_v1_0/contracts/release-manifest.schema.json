{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rockstaros:icd:release-manifest:v1",
  "title": "release-manifest / DESIGN SPECIFICATION ONLY",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "rockstaros.icd.release-manifest.v1"
    },
    "executionMode": {
      "enum": [
        "SIMULATION",
        "HARDWARE_IN_LOOP",
        "OPERATIONAL"
      ]
    },
    "dataClass": {
      "enum": [
        "SYNTHETIC",
        "MEASURED",
        "ESTIMATED",
        "REPLAY"
      ]
    },
    "siteId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "messageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "issuedAt": {
      "type": "object",
      "properties": {
        "utcMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "monotonicMs": {
          "type": "integer",
          "minimum": 0
        },
        "bootId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        "quality": {
          "enum": [
            "TRUSTED",
            "DEGRADED",
            "UNTRUSTED"
          ]
        },
        "uncertaintyMs": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "utcMs",
        "monotonicMs",
        "bootId",
        "quality",
        "uncertaintyMs"
      ],
      "additionalProperties": false
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "componentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "artifactDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "targetProfileId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "schemaMajor": {
      "type": "integer",
      "minimum": 1
    },
    "minimumBootVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "configurationDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rollbackPolicyRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "migrationPlanRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "testEvidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "approvalRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "updateSignerRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    }
  },
  "required": [
    "schemaVersion",
    "executionMode",
    "dataClass",
    "siteId",
    "nodeId",
    "messageId",
    "issuedAt",
    "releaseId",
    "componentId",
    "artifactDigest",
    "sourceRevision",
    "targetProfileId",
    "schemaMajor",
    "minimumBootVersion",
    "configurationDigest",
    "rollbackPolicyRef",
    "migrationPlanRef",
    "testEvidenceRefs",
    "approvalRefs",
    "updateSignerRef"
  ],
  "additionalProperties": false
}
