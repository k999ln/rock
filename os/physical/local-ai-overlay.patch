index 0000000000000000000000000000000000000000..9a2cf4f
--- /dev/null
+++ b/src/native/osBridge.ts
@@ -0,0 +1,148 @@
+import AsyncStorage from '@react-native-async-storage/async-storage';
+import {AppRegistry, NativeModules} from 'react-native';
+import {executeTool, parseNativeToolCall, proposalFor} from '../core/toolBroker';
+import {repository} from '../data/repository';
+import {modelRuntime} from './modelRuntime';
+import type {ChatMessage, PendingAction} from '../types';
+
+type BridgeData = {
+  kind?: unknown;
+  requestToken?: unknown;
+  prompt?: unknown;
+  contextJson?: unknown;
+  proposalId?: unknown;
+  approved?: unknown;
+};
+
+type NativeBridge = {
+  emitEvent(requestToken: string, event: string, payload: string): void;
+  setStatus(state: string, modelLoaded: boolean): void;
+};
+
+type StoredProposal = {
+  proposal: PendingAction;
+  expiresAt: number;
+};
+
+const bridge = NativeModules.RockLocalAiBridge as NativeBridge | undefined;
+const pendingPrefix = '@local-action/os-pending/';
+const maxText = 32768;
+const proposalTtlMs = 5 * 60 * 1000;
+
+function requiredText(value: unknown, name: string, max = maxText): string {
+  if (typeof value !== 'string' || !value.trim() || value.length > max) {
+    throw new Error(`INVALID_${name.toUpperCase()}`);
+  }
+  return value;
+}
+
+function emit(token: string, event: 'token' | 'proposal' | 'completed' | 'failed', payload: string): void {
+  if (!bridge) throw new Error('OS_BRIDGE_UNAVAILABLE');
+  bridge.emitEvent(token, event, payload.slice(0, maxText));
+}
+
+function parseContext(raw: unknown): ChatMessage[] {
+  if (raw === '' || raw == null) return [];
+  const text = requiredText(raw, 'context');
+  const value: unknown = JSON.parse(text);
+  if (!Array.isArray(value) || value.length > 12) throw new Error('INVALID_CONTEXT');
+  return value.map((item, index) => {
+    if (!item || typeof item !== 'object') throw new Error('INVALID_CONTEXT');
+    const candidate = item as {role?: unknown; content?: unknown};
+    if (candidate.role !== 'user' && candidate.role !== 'assistant') throw new Error('INVALID_CONTEXT');
+    return {
+      id: `os-context-${index}`,
+      role: candidate.role,
+      content: requiredText(candidate.content, 'context_content', 4000),
+      createdAt: new Date(0).toISOString(),
+    };
+  });
+}
+
+async function ensureModel(): Promise<void> {
+  const model = await repository.model();
+  if (!model) {
+    bridge?.setStatus('no_model', false);
+    throw new Error('NO_MODEL');
+  }
+  bridge?.setStatus('loading', false);
+  await modelRuntime.load(model.uri);
+  bridge?.setStatus('ready', true);
+}
+
+async function complete(data: BridgeData, token: string): Promise<void> {
+  await ensureModel();
+  bridge?.setStatus('busy', true);
+  const prompt = requiredText(data.prompt, 'prompt', 8000);
+  const messages = parseContext(data.contextJson);
+  messages.push({id: `os-${token}`, role: 'user', content: prompt, createdAt: new Date().toISOString()});
+  let streamed = false;
+  const result = await modelRuntime.complete(messages, chunk => {
+    streamed = true;
+    emit(token, 'token', chunk);
+  });
+  if (result.toolCalls.length > 1) throw new Error('MULTIPLE_TOOL_CALLS');
+  if (!result.toolCalls.length) {
+    emit(token, 'completed', streamed ? '' : (result.text || 'EMPTY_COMPLETION'));
+    return;
+  }
+  const call = parseNativeToolCall(result.toolCalls[0]);
+  const proposal = proposalFor(call);
+  if (!proposal) {
+    emit(token, 'completed', await executeTool(call));
+    return;
+  }
+  const stored: StoredProposal = {proposal, expiresAt: Date.now() + proposalTtlMs};
+  await AsyncStorage.setItem(`${pendingPrefix}${token}`, JSON.stringify(stored));
+  await repository.appendAudit('tool_proposed', `os:${call.name}`);
+  emit(token, 'proposal', JSON.stringify({proposalId: call.id, tool: call.name,
+                                          description: proposal.description}));
+}
+
+async function confirm(data: BridgeData, token: string): Promise<void> {
+  const proposalId = requiredText(data.proposalId, 'proposal_id', 80);
+  const raw = await AsyncStorage.getItem(`${pendingPrefix}${token}`);
+  if (!raw) throw new Error('PROPOSAL_NOT_FOUND');
+  const stored = JSON.parse(raw) as Partial<StoredProposal>;
+  if (!stored.proposal || typeof stored.expiresAt !== 'number') {
+    await AsyncStorage.removeItem(`${pendingPrefix}${token}`);
+    throw new Error('INVALID_PROPOSAL');
+  }
+  if (stored.expiresAt < Date.now()) {
+    await AsyncStorage.removeItem(`${pendingPrefix}${token}`);
+    throw new Error('PROPOSAL_EXPIRED');
+  }
+  const proposal = stored.proposal;
+  if (proposal.call.id !== proposalId) throw new Error('PROPOSAL_MISMATCH');
+  await AsyncStorage.removeItem(`${pendingPrefix}${token}`);
+  if (data.approved !== true) {
+    await repository.appendAudit('tool_denied', `os:${proposal.call.name}`);
+    emit(token, 'completed', '操作をキャンセルしました。');
+    return;
+  }
+  emit(token, 'completed', await executeTool(proposal.call));
+}
+
+async function runLocalAiTask(data: BridgeData): Promise<void> {
+  const token = requiredText(data.requestToken, 'request_token', 36);
+  try {
+    if (data.kind === 'complete') await complete(data, token);
+    else if (data.kind === 'confirm') await confirm(data, token);
+    else if (data.kind === 'cancel') {
+      await modelRuntime.stop();
+      await AsyncStorage.removeItem(`${pendingPrefix}${token}`);
+      emit(token, 'failed', 'CANCELLED');
+    } else throw new Error('INVALID_OPERATION');
+  } catch (error) {
+    const code = error instanceof Error && /^[A-Z0-9_]+$/.test(error.message)
+      ? error.message : 'LOCAL_AI_FAILED';
+    emit(token, 'failed', code);
+    bridge?.setStatus(modelRuntime.loaded ? 'ready' : 'error', modelRuntime.loaded);
+  } finally {
+    if (data.kind !== 'cancel') bridge?.setStatus(modelRuntime.loaded ? 'ready' : 'error', modelRuntime.loaded);
+  }
+}
+
+export function registerOsBridge(): void {
+  if (bridge) AppRegistry.registerHeadlessTask('RockLocalAi', () => runLocalAiTask);
+}
