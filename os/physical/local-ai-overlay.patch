diff --git a/android/app/src/main/java/com/localactionassistant/RockLocalAiService.kt b/android/app/src/main/java/com/localactionassistant/RockLocalAiService.kt
new file mode 100644
index 0000000000000000000000000000000000000000..c26df10c4bd7e60a6228eacd1d5391fe4fa81415
--- /dev/null
+++ b/android/app/src/main/java/com/localactionassistant/RockLocalAiService.kt
@@ -0,0 +1,74 @@
+package com.localactionassistant
+
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Binder
+import android.os.IBinder
+import android.os.Process
+import com.facebook.react.HeadlessJsTaskService
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.UiThreadUtil
+import com.facebook.react.jstasks.HeadlessJsTaskConfig
+import dev.rock.localai.ILocalAiCallback
+import dev.rock.localai.ILocalAiService
+import org.json.JSONObject
+
+class RockLocalAiService : HeadlessJsTaskService() {
+  private fun authenticate() {
+    val caller = Binder.getCallingUid()
+    val expected = try { packageManager.getPackageUid("dev.rock.automation", 0) }
+                   catch (_: PackageManager.NameNotFoundException) { throw SecurityException("BROKER_NOT_INSTALLED") }
+    if (caller != expected || packageManager.checkSignatures(Process.myUid(), caller) != PackageManager.SIGNATURE_MATCH)
+      throw SecurityException("UNTRUSTED_BROKER")
+  }
+
+  private fun token(value: String?) {
+    if (value == null || !Regex("[a-f0-9-]{36}").matches(value))
+      throw IllegalArgumentException("INVALID_REQUEST_TOKEN")
+  }
+
+  private fun start(kind: String, requestToken: String, callback: ILocalAiCallback,
+                    prompt: String = "", contextJson: String = "", proposalId: String = "",
+                    approved: Boolean = false) {
+    token(requestToken)
+    if (!RockLocalAiBroker.register(requestToken, callback)) throw IllegalStateException("REQUEST_BUSY")
+    val data = Arguments.createMap().apply {
+      putString("kind", kind); putString("requestToken", requestToken); putString("prompt", prompt)
+      putString("contextJson", contextJson); putString("proposalId", proposalId); putBoolean("approved", approved)
+    }
+    UiThreadUtil.runOnUiThread {
+      try { startTask(HeadlessJsTaskConfig("RockLocalAi", data, 90_000, true)) }
+      catch (_: Exception) { RockLocalAiBroker.cancel(requestToken) }
+    }
+  }
+
+  private val binder = object : ILocalAiService.Stub() {
+    override fun getApiVersion(): Int { authenticate(); return 1 }
+    override fun getStatus(): String {
+      authenticate()
+      val preferences = getSharedPreferences("rock-local-ai", 0)
+      return JSONObject().put("state", preferences.getString("state", "error"))
+          .put("modelLoaded", preferences.getBoolean("modelLoaded", false))
+          .put("runtime", "llama.rn").put("apiVersion", 1).toString()
+    }
+    override fun complete(requestToken: String?, prompt: String?, contextJson: String?, callback: ILocalAiCallback?) {
+      authenticate(); token(requestToken)
+      if (callback == null || prompt.isNullOrBlank() || prompt.toByteArray().size > 32768
+          || contextJson == null || contextJson.toByteArray().size > 32768) throw IllegalArgumentException("INVALID_REQUEST")
+      start("complete", requestToken!!, callback, prompt, contextJson)
+    }
+    override fun confirm(requestToken: String?, proposalId: String?, approved: Boolean, callback: ILocalAiCallback?) {
+      authenticate(); token(requestToken)
+      if (callback == null || proposalId == null || !Regex("[A-Za-z0-9_-]{1,80}").matches(proposalId))
+        throw IllegalArgumentException("INVALID_CONFIRMATION")
+      start("confirm", requestToken!!, callback, proposalId = proposalId, approved = approved)
+    }
+    override fun cancel(requestToken: String?) {
+      authenticate(); token(requestToken); RockLocalAiBroker.cancel(requestToken!!)
+      val data = Arguments.createMap().apply { putString("kind", "cancel"); putString("requestToken", requestToken) }
+      UiThreadUtil.runOnUiThread { startTask(HeadlessJsTaskConfig("RockLocalAi", data, 10_000, true)) }
+    }
+  }
+
+  override fun onBind(intent: Intent): IBinder = binder
+}
