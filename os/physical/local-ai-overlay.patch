+package com.localactionassistant
+
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReactContextBaseJavaModule
+import com.facebook.react.bridge.ReactMethod
+
+class RockLocalAiBridgeModule(context: ReactApplicationContext) : ReactContextBaseJavaModule(context) {
+  override fun getName(): String = "RockLocalAiBridge"
+
+  @ReactMethod
+  fun emitEvent(requestToken: String, event: String, payload: String) {
+    RockLocalAiBroker.emit(requestToken, event, payload)
+  }
+
+  @ReactMethod
+  fun setStatus(state: String, modelLoaded: Boolean) {
+    if (state !in setOf("ready", "no_model", "loading", "busy", "error")) return
+    reactApplicationContext.getSharedPreferences("rock-local-ai", 0).edit()
+        .putString("state", state).putBoolean("modelLoaded", modelLoaded).apply()
+  }
+}
diff --git a/android/app/src/main/java/com/localactionassistant/RockLocalAiBroker.kt b/android/app/src/main/java/com/localactionassistant/RockLocalAiBroker.kt
new file mode 100644
index 0000000000000000000000000000000000000000..57c63d712b87419be3c6d5d905e3752b0ddc0210
--- /dev/null
+++ b/android/app/src/main/java/com/localactionassistant/RockLocalAiBroker.kt
@@ -0,0 +1,38 @@
+package com.localactionassistant
+
+import dev.rock.localai.ILocalAiCallback
+import java.nio.charset.StandardCharsets
+import java.util.concurrent.ConcurrentHashMap
+
+object RockLocalAiBroker {
+  private data class Request(val callback: ILocalAiCallback, var bytes: Int = 0)
+  private val requests = ConcurrentHashMap<String, Request>()
+  private val events = setOf("token", "proposal", "completed", "failed")
+
+  fun register(token: String, callback: ILocalAiCallback): Boolean {
+    val registered = requests.putIfAbsent(token, Request(callback)) == null
+    if (registered) try { callback.asBinder().linkToDeath({ requests.remove(token) }, 0) }
+                    catch (_: Exception) { requests.remove(token); return false }
+    return registered
+  }
+
+  fun emit(token: String, event: String, payload: String) {
+    val request = requests[token] ?: return
+    if (event !in events) return fail(token, "INVALID_EVENT")
+    val size = payload.toByteArray(StandardCharsets.UTF_8).size
+    synchronized(request) {
+      if (size > 32768 || request.bytes + size > 32768) return fail(token, "INVALID_RESPONSE_SIZE")
+      request.bytes += size
+      try { request.callback.onEvent(token, event, payload) }
+      catch (_: Exception) { requests.remove(token) }
+      if (event != "token") requests.remove(token)
+    }
+  }
+
+  fun cancel(token: String) = fail(token, "CANCELLED")
+
+  private fun fail(token: String, code: String) {
+    val request = requests.remove(token) ?: return
+    try { request.callback.onEvent(token, "failed", code) } catch (_: Exception) { }
+  }
+}
