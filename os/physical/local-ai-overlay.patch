@@ -0,0 +1,39 @@
+import {createVisibleTokenStream, visibleAssistantText} from '../modelOutput';
+
+describe('visibleAssistantText', () => {
+  test('removes complete, orphan and unclosed reasoning markers', () => {
+    expect(visibleAssistantText('<think>secret\nwork</think>\n\nOFFLINE_OK')).toBe('OFFLINE_OK');
+    expect(visibleAssistantText('</think> answer')).toBe('answer');
+    expect(visibleAssistantText('safe <think>unfinished')).toBe('safe');
+  });
+
+  test('removes multiple case-insensitive reasoning blocks', () => {
+    expect(visibleAssistantText('<THINK>a</THINK> one <think>b</think> two')).toBe('one  two');
+  });
+});
+
+describe('createVisibleTokenStream', () => {
+  test('filters reasoning when tags are split across token boundaries', () => {
+    const output: string[] = [];
+    const stream = createVisibleTokenStream(token => output.push(token));
+    for (const token of ['<th', 'ink>', 'private', '</thi', 'nk>\n\n', 'CLEAN', '_OK']) stream.push(token);
+    expect(stream.finish()).toBe(true);
+    expect(output.join('')).toBe('CLEAN_OK');
+  });
+
+  test('fails closed for an unclosed reasoning block', () => {
+    const output: string[] = [];
+    const stream = createVisibleTokenStream(token => output.push(token));
+    for (const token of ['visible ', '<think>', 'private', ' chain']) stream.push(token);
+    expect(stream.finish()).toBe(true);
+    expect(output.join('')).toBe('visible ');
+  });
+
+  test('strips orphan closing tags without delaying ordinary text', () => {
+    const output: string[] = [];
+    const stream = createVisibleTokenStream(token => output.push(token));
+    for (const token of ['A', '</th', 'ink>', 'B']) stream.push(token);
+    expect(stream.finish()).toBe(true);
+    expect(output.join('')).toBe('AB');
+  });
+});
diff --git a/src/native/modelOutput.ts b/src/native/modelOutput.ts
new file mode 100644
index 0000000000000000000000000000000000000000..701f9df8ae2cdb2510ae21ba94617edf74a30e91
--- /dev/null
+++ b/src/native/modelOutput.ts
@@ -0,0 +1,98 @@
+const openTag = '<think>';
+const closeTag = '</think>';
+
+function earliestTag(text: string): {index: number; tag: string} | null {
+  const lower = text.toLowerCase();
+  const candidates = [openTag, closeTag]
+    .map(tag => ({index: lower.indexOf(tag), tag}))
+    .filter(candidate => candidate.index >= 0)
+    .sort((left, right) => left.index - right.index);
+  return candidates[0] ?? null;
+}
+
+function trailingTagPrefixLength(text: string, tags: string[]): number {
+  const lower = text.toLowerCase();
+  const longest = Math.min(lower.length, Math.max(...tags.map(tag => tag.length - 1)));
+  for (let size = longest; size > 0; size -= 1) {
+    const suffix = lower.slice(-size);
+    if (tags.some(tag => tag.startsWith(suffix))) return size;
+  }
+  return 0;
+}
+
+/** Remove model-internal reasoning markers before text reaches UI or OS clients. */
+export function visibleAssistantText(value: string): string {
+  return value
+    .replace(/<think>[\s\S]*?<\/think>/gi, '')
+    .replace(/<think>[\s\S]*$/gi, '')
+    .replace(/<\/?think>/gi, '')
+    .trim();
+}
+
+/**
+ * Filter reasoning tags across arbitrary token boundaries without buffering the
+ * whole visible answer. An unclosed reasoning block fails closed at finish.
+ */
+export function createVisibleTokenStream(emit: (text: string) => void): {
+  push(chunk: string): void;
+  finish(): boolean;
+} {
+  let pending = '';
+  let hidden = false;
+  let emitted = false;
+
+  const emitVisible = (text: string) => {
+    const visible = emitted ? text : text.replace(/^\s+/, '');
+    if (!visible) return;
+    emitted = true;
+    emit(visible);
+  };
+
+  const drain = (final: boolean) => {
+    while (pending) {
+      if (hidden) {
+        const closeIndex = pending.toLowerCase().indexOf(closeTag);
+        if (closeIndex >= 0) {
+          pending = pending.slice(closeIndex + closeTag.length);
+          hidden = false;
+          continue;
+        }
+        if (final) {
+          pending = '';
+          return;
+        }
+        pending = pending.slice(-trailingTagPrefixLength(pending, [closeTag]));
+        return;
+      }
+
+      const next = earliestTag(pending);
+      if (next) {
+        emitVisible(pending.slice(0, next.index));
+        pending = pending.slice(next.index + next.tag.length);
+        hidden = next.tag === openTag;
+        continue;
+      }
+      if (final) {
+        emitVisible(pending);
+        pending = '';
+        return;
+      }
+      const held = trailingTagPrefixLength(pending, [openTag, closeTag]);
+      emitVisible(held ? pending.slice(0, -held) : pending);
+      pending = held ? pending.slice(-held) : '';
+      return;
+    }
+  };
+
+  return {
+    push(chunk: string) {
+      if (!chunk) return;
+      pending += chunk;
+      drain(false);
+    },
+    finish() {
+      drain(true);
+      return emitted;
+    },
+  };
+}
