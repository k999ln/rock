@@ -0,0 +1,24 @@
+import {strictPlanText} from './modelOutput';
+
+export function ideaCount(schemaId: string): number | null {
+  const found = /^local-work@1\/ideas-([1-9]|10)-v1$/.exec(schemaId);
+  return found ? Number(found[1]) : null;
+}
+
+/** Only actual model strings are preserved; labels below are runtime-owned draft metadata. */
+export function canonicalIdeaDraft(schemaId: string, output: string): string {
+  const count = ideaCount(schemaId);
+  if (count === null) return output;
+  let text = strictPlanText(output);
+  if (text.startsWith('```json\n') && text.endsWith('\n```')) text = text.slice(8, -4).trim();
+  let value: {ideas?: unknown};
+  try { value = JSON.parse(text) as {ideas?: unknown}; } catch { throw new Error('INVALID_IDEA_JSON'); }
+  if (!value || Array.isArray(value) || Object.keys(value).length !== 1 || !Array.isArray(value.ideas) || value.ideas.length !== count)
+    throw new Error('IDEA_SCHEMA_COUNT_MISMATCH');
+  const ideas = value.ideas.map(idea => {
+    if (typeof idea !== 'string' || !idea.trim() || Array.from(idea).length > 24 || Array.from(idea).some(char => char.charCodeAt(0) < 32))
+      throw new Error('INVALID_IDEA_STRING');
+    return idea.trim();
+  });
+  return JSON.stringify({task: 'planning', title: 'サービスアイデア', body: JSON.stringify(ideas), summary: '- 発想案\n- 未実装\n- 要確認'});
+}
