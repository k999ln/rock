+import {completePlanBoundary, requestPlanStop} from '../planBoundary';
+
+describe('closed plan completion boundary', () => {
+  it('waits for a whole root and ignores braces and escaped quotes in strings', () => {
+    const json = JSON.stringify({body: 'return {"x": "}"}', nested: [{value: 1}]});
+    for (let i = 0; i < json.length; i++) expect(completePlanBoundary(json.slice(0, i))).toBe(false);
+    expect(completePlanBoundary(json)).toBe(true);
+  });
+  it('accepts only exact presentation envelopes and stops excessive output', () => {
+    expect(completePlanBoundary('<|im_start|>assistant\n{"task":"code"}')).toBe(true);
+    expect(completePlanBoundary('```json\n{"body":"code"}\n```')).toBe(true);
+    expect(completePlanBoundary('```json\n{"body":"code"}')).toBe(false);
+    expect(completePlanBoundary('{"a":1} trailing')).toBe(false);
+    expect(completePlanBoundary('{"a":1}{"b":2}')).toBe(false);
+    expect(completePlanBoundary('prose {"a":1}')).toBe(false);
+    expect(completePlanBoundary('x'.repeat(32769))).toBe(true);
+  });
+});
+
+describe('real native completion-stop return shapes', () => {
+  it('accepts the actual Android void result and invokes native stop once', () => {
+    const stop = jest.fn(() => undefined);
+    expect(() => requestPlanStop(stop)).not.toThrow();
+    expect(stop).toHaveBeenCalledTimes(1);
+  });
+  it('contains synchronous throws and asynchronous rejection', async () => {
+    expect(() => requestPlanStop(() => { throw new Error('native stop'); })).not.toThrow();
+    requestPlanStop(() => Promise.reject(new Error('native stop')));
+    await Promise.resolve(); await Promise.resolve();
+  });
+});
