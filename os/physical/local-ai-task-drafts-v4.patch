@@ -0,0 +1,25 @@
+/** A complete JSON envelope ends decoding; Broker still validates every field and permission. */
+export function completePlanBoundary(value: string): boolean {
+  if (value.length > 32768) return true; // stop excessive output; the Broker rejects it
+  let text = value.trimStart();
+  const prefix = '<|im_start|>assistant';
+  if (text.startsWith(prefix)) text = text.slice(prefix.length).trimStart();
+  const fenced = text.startsWith('```json\n');
+  if (fenced) text = text.slice(8);
+  if (!text.startsWith('{')) return false;
+  let depth = 0, quoted = false, escaped = false;
+  for (let i = 0; i < text.length; i++) {
+    const char = text[i];
+    if (quoted) {
+      if (escaped) escaped = false;
+      else if (char === '\\') escaped = true;
+      else if (char === '"') quoted = false;
+    } else if (char === '"') quoted = true;
+    else if (char === '{') depth++;
+    else if (char === '}' && --depth === 0) {
+      const rest = text.slice(i + 1).trim();
+      return fenced ? rest === '```' : rest === '';
+    }
+  }
+  return false;
+}
