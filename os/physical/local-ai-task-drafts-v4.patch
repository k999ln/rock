+import {canonicalIdeaDraft, ideaCount} from '../ideaPlan';
+import {planSpec} from '../planSchema';
+
+describe('structured ideation subtype', () => {
+  it('closes the family to one through ten real strings with exact array cardinality', () => {
+    expect(ideaCount('local-work@1/ideas-10-v1')).toBe(10);
+    expect(ideaCount('local-work@1/ideas-0-v1')).toBeNull();
+    expect(ideaCount('local-work@1/ideas-11-v1')).toBeNull();
+    const spec = planSpec('local-work@1/ideas-2-v1');
+    const schema = spec.responseFormat.json_schema?.schema as {properties: {ideas: {minItems: number; maxItems: number}}};
+    expect(schema.properties.ideas.minItems).toBe(2); expect(schema.properties.ideas.maxItems).toBe(2);
+  });
+  it('normalizes presentation only and never fills missing or invents extra items', () => {
+    const source = {ideas: ['ソファーの着座記録', '天井Miniの伝言']};
+    const result = JSON.parse(canonicalIdeaDraft('local-work@1/ideas-2-v1', '```json\n' + JSON.stringify(source) + '\n```')) as {task: string; body: string};
+    expect(result.task).toBe('planning'); expect(JSON.parse(result.body)).toEqual(source.ideas);
+    expect(() => canonicalIdeaDraft('local-work@1/ideas-3-v1', JSON.stringify(source))).toThrow('IDEA_SCHEMA_COUNT_MISMATCH');
+    expect(() => canonicalIdeaDraft('local-work@1/ideas-2-v1', JSON.stringify({...source, tool: 'shell'}))).toThrow();
+    expect(() => canonicalIdeaDraft('local-work@1/ideas-1-v1', '{"ideas":[{"text":"untrusted"}]}')).toThrow();
+  });
+});
