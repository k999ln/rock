+++ b/src/native/modelHandoff.ts
@@ -0,0 +1,30 @@
+export const MODEL_HANDOFF_MAX_BYTES = 4 * 1024 * 1024 * 1024;
+export const MODEL_HANDOFF_MIN_BYTES = 1024 * 1024;
+
+export type VerifiedModelHandoff = {
+  profileId: string;
+  weightsSha256: string;
+  expectedBytes: number;
+  modelUri: string;
+};
+
+/** Validate only the bounded internal file URI emitted by the authenticated native service. */
+export function validateModelHandoff(
+  profileId: unknown,
+  weightsSha256: unknown,
+  expectedBytes: unknown,
+  modelUri: unknown,
+): VerifiedModelHandoff {
+  if (typeof profileId !== 'string' || !/^[a-z0-9]+(?:[._-][a-z0-9]+){2,}$/.test(profileId))
+    throw new Error('INVALID_PROFILE_ID');
+  if (typeof weightsSha256 !== 'string' || !/^[a-f0-9]{64}$/.test(weightsSha256))
+    throw new Error('INVALID_EXPECTED_MODEL_HASH');
+  if (typeof expectedBytes !== 'number' || !Number.isSafeInteger(expectedBytes)
+      || expectedBytes < MODEL_HANDOFF_MIN_BYTES || expectedBytes > MODEL_HANDOFF_MAX_BYTES)
+    throw new Error('INVALID_MODEL_SIZE');
+  if (typeof modelUri !== 'string' || modelUri.length > 2048 || !modelUri.startsWith('file://')
+      || modelUri.includes('?') || modelUri.includes('#')
+      || !modelUri.endsWith(`/rock-models/${weightsSha256}.gguf`))
+    throw new Error('INVALID_MODEL_URI');
+  return {profileId, weightsSha256, expectedBytes, modelUri};
+}
