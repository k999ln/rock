+++ b/src/native/__tests__/modelHandoff.test.ts
@@ -0,0 +1,25 @@
+import {MODEL_HANDOFF_MAX_BYTES, validateModelHandoff} from '../modelHandoff';
+
+describe('authenticated model handoff envelope', () => {
+  const profileId = 'lifeline.health.v1';
+  const hash = 'a'.repeat(64);
+  const uri = `file:///data/user/0/com.localactionassistant/no_backup/rock-models/${hash}.gguf`;
+
+  it('accepts a bounded internal hash-addressed file for one exact profile', () => {
+    expect(validateModelHandoff(profileId, hash, 512 * 1024 * 1024, uri)).toEqual({
+      profileId, weightsSha256: hash, expectedBytes: 512 * 1024 * 1024, modelUri: uri,
+    });
+  });
+
+  it('rejects profile traversal, malformed hashes, and invalid lengths', () => {
+    expect(() => validateModelHandoff('../outside', hash, 1024 * 1024, uri)).toThrow('INVALID_PROFILE_ID');
+    expect(() => validateModelHandoff(profileId, '../hash', 1024 * 1024, uri)).toThrow('INVALID_EXPECTED_MODEL_HASH');
+    expect(() => validateModelHandoff(profileId, hash, MODEL_HANDOFF_MAX_BYTES + 1, uri)).toThrow('INVALID_MODEL_SIZE');
+  });
+
+  it('rejects URLs, query data, and paths outside runtime-private model storage', () => {
+    expect(() => validateModelHandoff(profileId, hash, 1024 * 1024, `https://example.invalid/${hash}.gguf`)).toThrow('INVALID_MODEL_URI');
+    expect(() => validateModelHandoff(profileId, hash, 1024 * 1024, `${uri}?token=secret`)).toThrow('INVALID_MODEL_URI');
+    expect(() => validateModelHandoff(profileId, hash, 1024 * 1024, `file:///tmp/${hash}.gguf`)).toThrow('INVALID_MODEL_URI');
+  });
+});
