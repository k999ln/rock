@@ -0,0 +1,20 @@
+import {articlePlanSchemaId, planSpec} from '../planSchema';
+
+describe('planSpec', () => {
+  test('locks the first selected Tool to one closed JSON schema', () => {
+    const spec = planSpec(articlePlanSchemaId);
+    expect(spec.responseFormat.type).toBe('json_schema');
+    const schema = spec.responseFormat.json_schema?.schema as {
+      additionalProperties?: boolean;
+      properties?: {toolId?: {enum?: string[]}; input?: {additionalProperties?: boolean}};
+    };
+    expect(schema.additionalProperties).toBe(false);
+    expect(schema.properties?.toolId?.enum).toEqual(['article-preparation@1']);
+    expect(schema.properties?.input?.additionalProperties).toBe(false);
+    expect(spec.systemPrompt).toContain('Tool呼出しは行わず');
+  });
+
+  test('rejects an unregistered plan schema', () => {
+    expect(() => planSpec('other-tool@1/input-v1')).toThrow('UNKNOWN_PLAN_SCHEMA');
+  });
+});
