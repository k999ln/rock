+/**
+ * Some GGUF chat templates expose their fixed assistant prefix even when the
+ * decoder is constrained by a JSON grammar. Remove only that exact control
+ * prefix; all other prose or wrappers remain for the Broker to reject.
+ */
+export function strictPlanText(value: string): string {
+  const visible = visibleAssistantText(value);
+  const assistantPrefix = '<|im_start|>assistant';
+  return (visible.startsWith(assistantPrefix)
+    ? visible.slice(assistantPrefix.length)
+    : visible).trim();
+}
