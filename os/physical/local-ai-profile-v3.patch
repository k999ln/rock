+describe('model profile weight hash binding', () => {
+  const digest = 'a'.repeat(64);
+
+  it('accepts only an exact SHA-256 match', () => {
+    expect(() => assertModelWeightsHash(digest, digest)).not.toThrow();
+    expect(() => assertModelWeightsHash(digest, digest.toUpperCase())).not.toThrow();
+  });
+
