+    expect(() => assertModelWeightsHash('not-a-hash', digest)).toThrow('MODEL_HASH_MISMATCH');
+    expect(() => assertModelWeightsHash(digest, 'b'.repeat(64))).toThrow('MODEL_HASH_MISMATCH');
+  });
+});
