{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rockstaros.local/schemas/mcp-registry-1.json",
  "title": "RockstarOS MCP Connector registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "servers"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "rockstaros-mcp-registry/1" },
    "servers": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "description",
              "transport",
              "command",
              "args",
              "cwd",
              "required"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "transport": { "const": "stdio" },
              "command": { "type": "string", "minLength": 1, "maxLength": 200 },
              "args": {
                "type": "array",
                "maxItems": 30,
                "items": { "type": "string", "maxLength": 500 }
              },
              "cwd": { "type": "string", "minLength": 1, "maxLength": 500 },
              "env": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{0,99}$"
                }
              },
              "required": { "type": "boolean" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "description",
              "transport",
              "url",
              "required"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "transport": { "const": "streamable_http" },
              "url": { "type": "string", "format": "uri", "maxLength": 500 },
              "authEnv": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,99}$"
              },
              "required": { "type": "boolean" }
            }
          }
        ]
      }
    }
  }
}
