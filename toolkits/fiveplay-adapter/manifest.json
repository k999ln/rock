{
  "manifest_version": 3,
  "name": "RockstarOS FivePlay Bridge Preview",
  "version": "0.1.0",
  "description": "FivePlayの画面上からMacのRockstarOSへ仕事を依頼する開発用adapter",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:5217/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://fiveplay.lol/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]
}
