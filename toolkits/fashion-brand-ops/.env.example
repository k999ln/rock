# Local persistence. Relative paths resolve from this app directory.
FASHION_BRAND_DB_PATH=./data/fashion-brand-ops.db
FASHION_HTTP_HOST=127.0.0.1
FASHION_HTTP_PORT=8787
FASHION_MCP_BEARER_TOKEN=
ROCKSTAR_TENANT_ID=
ROCKSTAR_PACKAGE_DIGEST=ad89ea3df0027cdf671fbb91602fb8ea2b14a71f29d0b19db5ac8da822733954

# Required for approving external effects. Use at least 32 random bytes in production.
ROCKSTAR_APPROVAL_SECRET=

# Safe defaults. A non-mock provider fails closed when its required values are absent.
FASHION_CREATIVE_PROVIDER=mock
FASHION_SOCIAL_PROVIDER=mock
FASHION_PAYMENT_PROVIDER=mock
FASHION_NOTIFICATION_PROVIDER=mock
FASHION_ALLOWED_HOSTS=api.stripe.com,graph.facebook.com

# Higgsfield-compatible HTTP adapter. The exact endpoint is operator-owned/configurable.
HIGGSFIELD_API_URL=
HIGGSFIELD_API_KEY=

# Instagram/Meta official Graph API, or an operator-owned OAuth bridge.
SOCIAL_PROVIDER_URL=
SOCIAL_PROVIDER_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_BASE_URL=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_INSIGHTS_METRICS=reach,impressions,profile_views

# Stripe provider and webhook verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Notification webhook adapter.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
