# Sky Market commerce runs in the Web server, separately from the legacy billing
# Worker below. Keep these values in server secret bindings / ignored local env;
# never use NEXT_PUBLIC_/VITE_ prefixes or send secrets to browsers, LLMs or MCPs.
# Empty keys keep payments unavailable. Test/live credentials must match the mode.
SKY_PAYMENTS_MODE=test
SKY_STRIPE_SECRET_KEY=
SKY_STRIPE_WEBHOOK_SECRET=
# Exact origin only: no path, query, fragment or credentials. HTTP loopback is
# allowed only in test mode. Live currently requires the trusted Sites gateway.
SKY_PAYMENT_ORIGIN=http://localhost:3107
# Stripe delivers signed raw-body events to /api/sky/commerce/webhook. The host
# must allow public ingress for this path without exposing identity-header bypasses.

# Legacy revenue settlement uses its own Worker and short-lived billing tokens.
# Its old subscription Checkout routes remain retired; these settings do not
# configure Sky Market purchases.
BILLING_SERVICE_URL=https://your-billing-worker.example
BILLING_SHARED_SECRET=at-least-32-random-characters-shared-with-the-billing-worker
# A provider adapter signs a confirmed payment receipt for the Sky bridge. Use
# one adapter identity per deployment until provider-specific secret storage is added.
EARNING_PROVIDER_ID=your-provider-adapter-id
EARNING_PROVIDER_SECRET=at-least-32-random-characters-shared-with-that-provider-adapter
# The bridge re-signs the checked receipt for the isolated settlement Worker.
SETTLEMENT_INGEST_SECRET=at-least-32-random-characters-shared-with-the-billing-worker
# Shared only with the Rockstar_ibot Telegram bridge. It authorizes activation/listing
# requests; it is not a developer key and must never be sent to Telegram users.
SKY_TELEGRAM_BRIDGE_SECRET=at-least-32-random-characters-shared-with-rockstar-ibot

# Required only by the isolated Sky curation endpoint. Keep this out of the
# browser and developer SDK. A package is public or distributable only after a
# recorded review made with this server-side credential.
SKY_REVIEWER_ID=rockstaros-reviewer
SKY_REVIEWER_SECRET=sky_review_at-least-32-random-characters

# Optional text-model adapters. Sky never accepts these secrets from the browser
# and never stores them in D1. The standard path remains local/offline.
SKY_REMOTE_LLM_ENABLED=false
OPENAI_API_KEY=server-only-openai-key
ANTHROPIC_API_KEY=server-only-anthropic-key
GOOGLE_GENERATIVE_AI_API_KEY=server-only-google-key
# For LM Studio, llama.cpp, vLLM or another OpenAI-compatible endpoint.
SKY_LLM_COMPATIBLE_BASE_URL=http://127.0.0.1:1234
SKY_LLM_COMPATIBLE_API_KEY=
# Ollama is local by default; change only for a deliberately reachable runtime.
SKY_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional Product Hunt discovery. Keep the token in the scheduled runner only;
# business/commercial collection requires approval from Product Hunt.
PRODUCT_HUNT_ACCESS_TOKEN=
PRODUCT_HUNT_BUSINESS_APPROVED=false
