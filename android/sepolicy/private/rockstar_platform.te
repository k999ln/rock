# Source policy for the future platform-service APK. Product wiring and enforcing proof are separate gates.
type rockstar_platform_app, domain;
type rockstar_platform_app_exec, exec_type, file_type, system_file_type;
type rockstar_platform_data_file, file_type, data_file_type, app_data_file_type;
type rock_tool_app, domain;
type rock_tool_app_exec, exec_type, file_type, system_file_type;
type rock_tool_data_file, file_type, data_file_type, app_data_file_type;
type rock_mcp_app, domain;
type rock_mcp_app_exec, exec_type, file_type, system_file_type;
type rock_mcp_data_file, file_type, data_file_type, app_data_file_type;
type rock_provider_app, domain;
type rock_provider_app_exec, exec_type, file_type, system_file_type;
type rock_provider_data_file, file_type, data_file_type, app_data_file_type;

app_domain(rockstar_platform_app)
app_domain(rock_tool_app)
app_domain(rock_mcp_app)
app_domain(rock_provider_app)

binder_call(rockstar_platform_app, rock_tool_app)
binder_call(rockstar_platform_app, rock_mcp_app)
binder_call(rockstar_platform_app, rock_provider_app)
binder_call(rock_tool_app, rockstar_platform_app)
binder_call(rock_mcp_app, rockstar_platform_app)
binder_call(rock_provider_app, rockstar_platform_app)

# Only the OS broker may manage the platform database and Keystore-backed backup envelope.
neverallow { rock_tool_app rock_mcp_app rock_provider_app } rockstar_platform_app:process ptrace;
neverallow rock_tool_app { rock_mcp_app rock_provider_app }:binder call;
neverallow rock_mcp_app { rock_tool_app rock_provider_app }:binder call;
neverallow rock_provider_app { rock_tool_app rock_mcp_app }:binder call;
neverallow rock_tool_app { rockstar_platform_data_file rock_mcp_data_file rock_provider_data_file }:file { create write append unlink rename relabelfrom relabelto };
neverallow rock_mcp_app { rockstar_platform_data_file rock_tool_data_file rock_provider_data_file }:file { create write append unlink rename relabelfrom relabelto };
neverallow rock_provider_app { rockstar_platform_data_file rock_tool_data_file rock_mcp_data_file }:file { create write append unlink rename relabelfrom relabelto };

# External execution is broker-mediated. Raw block devices, kernel interfaces and arbitrary app data stay denied.
neverallow { rockstar_platform_app rock_tool_app rock_mcp_app rock_provider_app } block_device:blk_file *;
neverallow { rock_tool_app rock_mcp_app rock_provider_app } kernel:security *;
