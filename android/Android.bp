// Source-build integration for the virtual OS prototype; not yet Soong-build verified.
java_library {
    name: "rock-automation-core",
    srcs: ["core/src/main/java/**/*.java"],
    java_resource_dirs: ["core/src/main/resources"],
    sdk_version: "current",
    min_sdk_version: "35",
    java_version: "11",
}

android_library {
    name: "rock-tool-sdk",
    manifest: "tool-sdk/src/aosp/AndroidManifest.xml",
    srcs: ["tool-sdk/src/main/java/**/*.java", "tool-sdk/src/main/aidl/**/*.aidl"],
    aidl: { local_include_dirs: ["tool-sdk/src/main/aidl"] },
    static_libs: ["rock-automation-core"],
    sdk_version: "current",
    min_sdk_version: "35",
    java_version: "11",
}

android_library {
    name: "rock-local-ai-api",
    manifest: "local-ai-api/src/aosp/AndroidManifest.xml",
    srcs: ["local-ai-api/src/main/aidl/**/*.aidl"],
    aidl: { local_include_dirs: ["local-ai-api/src/main/aidl"] },
    sdk_version: "current",
    min_sdk_version: "35",
    java_version: "11",
}

android_library {
    name: "rock-shell-api",
    manifest: "shell-api/src/aosp/AndroidManifest.xml",
    srcs: ["shell-api/src/main/aidl/**/*.aidl"],
    aidl: { local_include_dirs: ["shell-api/src/main/aidl"] },
    sdk_version: "current",
    min_sdk_version: "35",
    java_version: "11",
}

android_app {
    name: "RockAutomationPrototype",
    manifest: "automation/src/aosp/AndroidManifest.xml",
    srcs: ["automation/src/main/java/**/*.java"],
    static_libs: ["rock-tool-sdk", "rock-local-ai-api", "rock-shell-api"],
    sdk_version: "current",
    min_sdk_version: "35",
    target_sdk_version: "35",
    certificate: "testkey",
    product_specific: true,
    optimize: { enabled: false },
}

android_app {
    name: "RockShell",
    manifest: "shell/src/aosp/AndroidManifest.xml",
    srcs: ["shell/src/main/java/**/*.java"],
    static_libs: ["rock-shell-api"],
    sdk_version: "current",
    min_sdk_version: "35",
    target_sdk_version: "35",
    certificate: "testkey",
    product_specific: true,
    optimize: { enabled: false },
}

android_app {
    name: "RockArticleToolPrototype",
    manifest: "article-tool/src/aosp/AndroidManifest.xml",
    srcs: ["article-tool/src/main/java/**/*.java"],
    static_libs: ["rock-tool-sdk"],
    sdk_version: "current",
    min_sdk_version: "35",
    target_sdk_version: "35",
    certificate: "testkey",
    product_specific: true,
    optimize: { enabled: false },
}

// Restricted, non-launcher emergency Agent. Production replaces testkey with
// its dedicated release certificate and supplies public trust anchors via RRO.
android_app {
    name: "RockOperatorAgent",
    manifest: "operator-agent/src/aosp/AndroidManifest.xml",
    srcs: ["operator-agent/src/main/java/**/*.java"],
    resource_dirs: ["operator-agent/src/main/res"],
    sdk_version: "current",
    min_sdk_version: "35",
    target_sdk_version: "35",
    certificate: "testkey",
    product_specific: true,
    optimize: { enabled: false },
}
