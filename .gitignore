# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
._*
__MACOSX/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*
!**/.env.example

# deployment and generated files
.vercel
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

*.tsbuildinfo
/data/discovered.json
/data/*.tmp

# Android/OS generated artifacts and local toolchains
/android/.gradle/
/android/**/build/
/android/local.properties
/android/.idea/
**/.gradle/
services/**/work/
*.jks
*.keystore
/os/local/

# Python tool caches
__pycache__/
*.pyc

# generated from encrypted private/ files; never commit
/lib/generated/

# Local replay diagnostics are regenerated and never belong in source history.
replay_pid*.log

# Locally prepared, pinned camera runtime (regenerate via scripts/prepare-mii-input.mjs)
/public/mii-input-runtime/
/public/.mii-input-*/

# Local render/export products stay outside source history.
/output/

# Eve の回の記録（本人の広告リンク・売上の CSV が入る。scripts/eve-run.mjs の既定の置き場）
data/eve-runs/private/

# Reproducible mii assembly drawings; renderer and BOM are versioned.
/output/pdf/mii-prototype-wiring.pdf

/output/pdf/mii-body-hw1-wiring.pdf

/output/pdf/mii-portable-p2-wiring.pdf

/output/pdf/mii-portable-p3-wiring.pdf
/output/pdf/mii-fire-f2-wiring.pdf

# Private outbound inquiry drafts and delivery receipts.
/output/inquiries/

/output/pdf/mii-fire-f3-wiring.pdf

/public/noah-offline.html
/public/noah-sw.js
