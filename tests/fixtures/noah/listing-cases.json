{
  "note": "ローンチの一覧に載せる条件の表。純関数（noahListing）と SQL（noah-regroup-v1.sql・noah-listing-v1.sql）の両方が、この表と同じ結果になることを確かめる。合成の値。",
  "cases": [
    { "name": "握手が通り、押すだけの道具がある", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-remote", "setup": 0, "auth": "none", "result": "ok", "level": 1, "formTools": 3, "oneTapTools": 1 }, "expect": { "listed": true, "section": "new", "oneTap": true } },
    { "name": "握手が通り、入力の要る道具だけ", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-remote", "setup": 0, "auth": "none", "result": "ok", "level": 1, "formTools": 2, "oneTapTools": 0 }, "expect": { "listed": true, "section": "new", "oneTap": false } },
    { "name": "人が動かして成果が返った", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-remote", "setup": 0, "auth": "none", "result": "ok", "level": 2, "formTools": 5, "oneTapTools": 3 }, "expect": { "listed": true, "section": "ran", "oneTap": true } },
    { "name": "握手が 1 回失敗しただけ（level は 1 のまま）", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-remote", "setup": 0, "auth": "none", "result": "unreachable", "level": 1, "formTools": 2, "oneTapTools": 1, "failures": 1 }, "expect": { "listed": true, "section": "new", "oneTap": true } },
    { "name": "相手が混んでいる（level は変わらない）", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-remote", "setup": 0, "auth": "none", "result": "rate_limited", "level": 2, "formTools": 2, "oneTapTools": 0 }, "expect": { "listed": true, "section": "ran", "oneTap": false } },
    { "name": "まだ握手していない", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-remote", "setup": 0, "auth": "unknown", "result": "unchecked", "level": 0, "formTools": null, "oneTapTools": null }, "expect": { "listed": false, "reason": "not_checked" } },
    { "name": "相手の許可が要る（401、取り方が分かった）", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-remote", "setup": 0, "auth": "oauth", "result": "auth_required", "level": 0, "formTools": null, "oneTapTools": null }, "expect": { "listed": false, "reason": "needs_permission" } },
    { "name": "相手の許可が要る（401、鍵）", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-remote", "setup": 0, "auth": "key", "result": "auth_required", "level": 0, "formTools": null, "oneTapTools": null }, "expect": { "listed": false, "reason": "needs_permission" } },
    { "name": "許可を取ってつないだ物（ローンチの後の道）", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-remote", "setup": 0, "auth": "oauth", "result": "ok", "level": 1, "formTools": 4, "oneTapTools": 1 }, "expect": { "listed": false, "reason": "needs_permission" } },
    { "name": "呼ぶたびの支払いが要る", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-remote", "setup": 0, "auth": "payment", "result": "payment_required", "level": 0, "formTools": null, "oneTapTools": null }, "expect": { "listed": false, "reason": "needs_payment" } },
    { "name": "握手が通らない", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-remote", "setup": 0, "auth": "unknown", "result": "unreachable", "level": 0, "formTools": null, "oneTapTools": null }, "expect": { "listed": false, "reason": "not_responding" } },
    { "name": "2 回続けて失敗して level が 0 になった", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-remote", "setup": 0, "auth": "none", "result": "unreachable", "level": 0, "formTools": 2, "oneTapTools": 1, "failures": 2 }, "expect": { "listed": false, "reason": "not_responding" } },
    { "name": "形が合わない", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-remote", "setup": 0, "auth": "unknown", "result": "incompatible", "level": 0, "formTools": null, "oneTapTools": null }, "expect": { "listed": false, "reason": "not_responding" } },
    { "name": "入力欄で使える道具が無い", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-remote", "setup": 0, "auth": "none", "result": "ok", "level": 1, "formTools": 0, "oneTapTools": 0 }, "expect": { "listed": false, "reason": "no_form_tool" } },
    { "name": "入力欄の数をまだ数えていない", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-remote", "setup": 0, "auth": "none", "result": "ok", "level": 1, "formTools": null, "oneTapTools": null }, "expect": { "listed": false, "reason": "no_form_tool" } },
    { "name": "本人の鍵の入力が要る", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-remote", "setup": 1, "auth": "key", "result": "unchecked", "level": 0, "formTools": null, "oneTapTools": null }, "expect": { "listed": false, "reason": "needs_key" } },
    { "name": "端末で動かす配布", "source": "mcp-registry", "state": "active", "check": { "mouth": "mcp-package", "surface": "terminal", "setup": 0, "auth": "none", "result": "unchecked", "level": 0, "formTools": null, "oneTapTools": null }, "expect": { "listed": false, "reason": "later_mouth" } },
    { "name": "量産の系列", "source": "mcp-registry", "state": "active", "bulk": true, "check": { "mouth": "mcp-remote", "setup": 0, "auth": "none", "result": "ok", "level": 1, "formTools": 3, "oneTapTools": 1 }, "expect": { "listed": false, "reason": "bulk" } },
    { "name": "Space（握手は通っている）", "source": "hf-mcp-space", "state": "active", "check": { "mouth": "space-mcp", "setup": 0, "auth": "none", "result": "ok", "level": 1, "formTools": 1, "oneTapTools": 0 }, "expect": { "listed": false, "reason": "later_source" } },
    { "name": "ACP の Agent", "source": "acp-registry", "state": "active", "check": { "mouth": "acp", "surface": "terminal", "setup": 0, "auth": "none", "result": "unchecked", "level": 0, "formTools": null, "oneTapTools": null }, "expect": { "listed": false, "reason": "later_source" } },
    { "name": "下書きを作れない", "source": "mcp-registry", "state": "unsupported", "check": null, "expect": { "listed": false, "reason": "unsupported" } },
    { "name": "出どころから外れた", "source": "mcp-registry", "state": "withdrawn", "check": { "mouth": "mcp-remote", "setup": 0, "auth": "none", "result": "ok", "level": 2, "formTools": 3, "oneTapTools": 1 }, "expect": { "listed": false, "reason": "withdrawn" } },
    { "name": "運営が取り下げた", "source": "mcp-registry", "state": "active", "withdrawn": true, "check": { "mouth": "mcp-remote", "setup": 0, "auth": "none", "result": "ok", "level": 2, "formTools": 3, "oneTapTools": 1 }, "expect": { "listed": false, "reason": "withdrawn" } },
    { "name": "30 日つながらず隠した", "source": "mcp-registry", "state": "active", "hidden": true, "check": { "mouth": "mcp-remote", "setup": 0, "auth": "none", "result": "ok", "level": 1, "formTools": 3, "oneTapTools": 1 }, "expect": { "listed": false, "reason": "hidden" } }
  ]
}
