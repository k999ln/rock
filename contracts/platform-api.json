{
  "schemaVersion": 1,
  "apiVersion": 1,
  "minSupportedApi": 1,
  "maxSupportedApi": 1,
  "componentKinds": ["TOOL", "MCP", "PROVIDER"],
  "registrationTrust": "installed_apk_signer_and_uid_verified_by_os_broker",
  "managementPermission": "dev.rock.permission.MANAGE_PLATFORM",
  "approvalFlow": ["PROPOSED", "DEVICE_CREDENTIAL", "ISSUED", "CONSUMED"],
  "approvalMaxLifetimeMs": 604800000,
  "ledger": {
    "model": "append_only_owner_scoped",
    "idempotency": ["owner_request_key", "owner_provider_reference", "owner_reversed_receipt"],
    "mutation": "compensating_reversal_only"
  },
  "storage": {
    "schemaVersion": 2,
    "migration": "transactional_fail_closed",
    "backupFormat": "rockstar-platform-backup/1",
    "encryption": "AES-256-GCM_ANDROID_KEYSTORE",
    "recoverableBackupFormat": "avocadoos-recoverable-backup/2",
    "recoverableBackupEncryption": "AES-256-GCM_FRESH_DEK_DUAL_WRAPPED_BY_ANDROID_KEYSTORE_AND_HKDF_SHA256_OWNER_RECOVERY",
    "recoverableBackupStatus": "CORE_IMPLEMENTED_OWNER_PHRASE_UI_IMPORT_AND_REBINDING_PENDING",
    "scope": "android_user",
    "maxPlaintextBytes": 4194304
  },
  "updates": {
    "requires": ["same_component_identity", "same_signer", "platform_api_overlap", "stored_schema_compatibility"],
    "rollback": "cached_older_version_only"
  },
  "isolation": {
    "uid": "distinct_android_application_uid",
    "selinux": "build_time_package_allowlist",
    "runtimeRegistrationCanGrantDomain": false,
    "crossComponentBinder": "deny_except_explicit_broker_edges",
    "currentLayout": "dev.rock.automation_contains_ui_and_platform_broker",
    "targetLayout": "dev.rock.shell_ui_separate_from_dev.rock.automation_headless_broker",
    "targetPolicy": "data/android-release-architecture-policy.json",
    "targetStateImplemented": false
  },
  "implementationStatus": "SOURCE_PARTIAL_UI_BROKER_SPLIT_OPERATOR_AGENT_BACKUP_V2_RUNTIME_AND_SEPOLICY_BUILD_PENDING",
  "releaseStatus": "NOT_PRODUCTION_READY"
}
